<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_ITServiceRequest" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude-BPMN-Generator" exporterVersion="1.0">
  <bpmn:process id="Process_ITServiceRequest" name="IT Service Request Handling" isExecutable="false">
    <bpmn:startEvent id="start3" name="Employee Reports IT Problem">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t3_submit" name="Submit IT Support Request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3_register" name="Register the Request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3_severity" name="Check Severity of Problem">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw3_severity" name="Severity Level?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3_assign_low" name="Assign to Support Technician">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3_assign_high" name="Assign to Senior Technician">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3_investigate" name="Technician Investigates Problem">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw3_resolve" name="Can be Resolved?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3_fix" name="Technician Fixes the Problem">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3_escalate" name="Escalate to External Service Provider">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3_updatestatus" name="Update Request Status">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3_notify" name="Send Resolution Notification">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end3" name="Request Closed">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start3" targetRef="t3_submit"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t3_submit" targetRef="t3_register"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t3_register" targetRef="t3_severity"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t3_severity" targetRef="gw3_severity"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="gw3_severity" targetRef="t3_assign_low" name="Low"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="gw3_severity" targetRef="t3_assign_high" name="High"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t3_assign_low" targetRef="t3_investigate"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t3_assign_high" targetRef="t3_investigate"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t3_investigate" targetRef="gw3_resolve"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="gw3_resolve" targetRef="t3_fix" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="gw3_resolve" targetRef="t3_escalate" name="No"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t3_fix" targetRef="t3_updatestatus"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="t3_escalate" targetRef="t3_updatestatus"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t3_updatestatus" targetRef="t3_notify"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="t3_notify" targetRef="end3"/>
  </bpmn:process>
