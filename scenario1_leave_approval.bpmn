<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_LeaveApproval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude-BPMN-Generator" exporterVersion="1.0">
  <bpmn:process id="Process_LeaveApproval" name="Employee Leave Approval" isExecutable="false">
    <bpmn:startEvent id="start1" name="Leave Request Submitted">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1_check" name="Check Leave Balance">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw1_balance" name="Sufficient Balance?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1_manager" name="Send Request to Manager for Approval">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw1_decision" name="Manager Decision?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1_update" name="Update Employee's Leave Balance">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t1_notify_approve" name="Send Approval Notification">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end1_approve" name="Approved">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1_notify_reject" name="Send Rejection Notification">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end1_reject" name="Rejected">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1_notify_insuff" name="Send Insufficient-Balance Notification">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end1_insuff" name="Insufficient Balance">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start1" targetRef="t1_check"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1_check" targetRef="gw1_balance"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="gw1_balance" targetRef="t1_manager" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="gw1_balance" targetRef="t1_notify_insuff" name="No"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t1_manager" targetRef="gw1_decision"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="gw1_decision" targetRef="t1_update" name="Approved"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="gw1_decision" targetRef="t1_notify_reject" name="Rejected"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t1_update" targetRef="t1_notify_approve"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t1_notify_approve" targetRef="end1_approve"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t1_notify_reject" targetRef="end1_reject"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t1_notify_insuff" targetRef="end1_insuff"/>
  </bpmn:process>
