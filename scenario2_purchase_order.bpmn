<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_PurchaseOrder" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude-BPMN-Generator" exporterVersion="1.0">
  <bpmn:process id="Process_PurchaseOrder" name="Online Purchase Order Processing" isExecutable="false">
    <bpmn:startEvent id="start2" name="Customer Places Order">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t2_check" name="Check Product Availability">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw2_avail" name="Product Available?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2_outofstock" name="Notify Customer: Out of Stock">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end2_outofstock" name="Out of Stock">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t2_payment" name="Process Payment">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw2_pay" name="Payment Successful?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2_payfail" name="Notify Customer: Payment Failure">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end2_payfail" name="Payment Failed">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t2_confirm" name="Confirm Order &amp; Prepare for Shipment">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2_ship" name="Ship the Order">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2_shipconf" name="Send Shipping Confirmation">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end2_shipped" name="Order Shipped">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start2" targetRef="t2_check"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t2_check" targetRef="gw2_avail"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="gw2_avail" targetRef="t2_outofstock" name="No"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="gw2_avail" targetRef="t2_payment" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t2_outofstock" targetRef="end2_outofstock"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t2_payment" targetRef="gw2_pay"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="gw2_pay" targetRef="t2_payfail" name="Fail"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="gw2_pay" targetRef="t2_confirm" name="Success"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t2_payfail" targetRef="end2_payfail"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t2_confirm" targetRef="t2_ship"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t2_ship" targetRef="t2_shipconf"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t2_shipconf" targetRef="end2_shipped"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_PurchaseOrder">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_PurchaseOrder" bpmnElement="Process_PurchaseOrder">
      <bpmndi:BPMNShape id="start2_di" bpmnElement="start2">
        <omgdc:Bounds x="62.0" y="182.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="35" y="222.0" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_check_di" bpmnElement="t2_check">
        <omgdc:Bounds x="170.0" y="160.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw2_avail_di" bpmnElement="gw2_avail">
