        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="335" y="229.0" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_outofstock_di" bpmnElement="t2_outofstock">
        <omgdc:Bounds x="470.0" y="40.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end2_outofstock_di" bpmnElement="end2_outofstock">
        <omgdc:Bounds x="662.0" y="62.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="635" y="102.0" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_payment_di" bpmnElement="t2_payment">
        <omgdc:Bounds x="470.0" y="160.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw2_pay_di" bpmnElement="gw2_pay">
        <omgdc:Bounds x="655.0" y="175.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="635" y="229.0" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_payfail_di" bpmnElement="t2_payfail">
        <omgdc:Bounds x="790.0" y="40.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end2_payfail_di" bpmnElement="end2_payfail">
        <omgdc:Bounds x="982.0" y="62.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="955" y="102.0" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_confirm_di" bpmnElement="t2_confirm">
        <omgdc:Bounds x="790.0" y="280.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_ship_di" bpmnElement="t2_ship">
        <omgdc:Bounds x="950.0" y="280.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_shipconf_di" bpmnElement="t2_shipconf">
        <omgdc:Bounds x="1110.0" y="280.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end2_shipped_di" bpmnElement="end2_shipped">
        <omgdc:Bounds x="1302.0" y="302.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1275" y="342.0" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="98.0" y="200.0"/>
        <omgdi:waypoint x="170.0" y="200.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="270.0" y="200.0"/>
