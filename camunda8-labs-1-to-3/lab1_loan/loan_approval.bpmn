<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="loan_approval_definitions" targetNamespace="https://example.org/education/camunda8" exporter="Codex" exporterVersion="1.0">
  <bpmn:process id="loan_approval" name="loan approval" isExecutable="true">
    <bpmn:startEvent id="start" name="Application received" />
    <bpmn:serviceTask id="validate" name="Validate applicant">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan-validate" retries="2" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="valid" name="Eligible details?" gatewayDirection="Diverging" />
    <bpmn:endEvent id="invalid" name="Rejected: invalid details" />
    <bpmn:serviceTask id="credit" name="Assess credit (REST)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="http://localhost:8085/mock/credit" target="url" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="= { applicantRef: applicantRef, monthlyIncome: monthlyIncome, requestedAmount: requestedAmount, simulateError: simulateApiError }" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="creditResponse" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="decide" name="Loan decision (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="loan_eligibility" resultVariable="loanDecision" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="route" name="Decision?" gatewayDirection="Diverging" />
    <bpmn:endEvent id="approved" name="Approved" />
    <bpmn:endEvent id="rejected" name="Rejected" />
    <bpmn:userTask id="review" name="Manual loan review">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="reviewRoute" name="Review approved?" gatewayDirection="Diverging" />
    <bpmn:endEvent id="manualYes" name="Approved after review" />
    <bpmn:endEvent id="manualNo" name="Rejected after review" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="validate" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="validate" targetRef="valid" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="valid" targetRef="invalid" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_4" sourceRef="valid" targetRef="credit" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationOk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_5" sourceRef="credit" targetRef="decide" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="decide" targetRef="route" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="route" targetRef="approved" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= loanDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_8" sourceRef="route" targetRef="rejected" name="Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= loanDecision = "Rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_9" sourceRef="route" targetRef="review" name="Manual review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= loanDecision = "Manual Review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_10" sourceRef="review" targetRef="reviewRoute" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="reviewRoute" targetRef="manualYes" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_12" sourceRef="reviewRoute" targetRef="manualNo" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="loan_approval_diagram">
    <bpmndi:BPMNPlane id="loan_approval_plane" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validate_di" bpmnElement="validate">
        <dc:Bounds x="180" y="188" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="valid_di" bpmnElement="valid">
        <dc:Bounds x="370" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="invalid_di" bpmnElement="invalid">
        <dc:Bounds x="445" y="365" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="credit_di" bpmnElement="credit">
        <dc:Bounds x="470" y="188" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decide_di" bpmnElement="decide">
        <dc:Bounds x="660" y="188" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="route_di" bpmnElement="route">
        <dc:Bounds x="850" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approved_di" bpmnElement="approved">
        <dc:Bounds x="1070" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejected_di" bpmnElement="rejected">
        <dc:Bounds x="1070" y="230" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review">
        <dc:Bounds x="950" y="350" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewRoute_di" bpmnElement="reviewRoute">
        <dc:Bounds x="1150" y="370" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manualYes_di" bpmnElement="manualYes">
        <dc:Bounds x="1320" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manualNo_di" bpmnElement="manualNo">
        <dc:Bounds x="1320" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="116" y="228.0" />
        <di:waypoint x="180" y="228.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="320" y="228.0" />
        <di:waypoint x="370" y="228.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="406" y="228.0" />
        <di:waypoint x="445" y="383.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="406" y="228.0" />
        <di:waypoint x="470" y="228.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="610" y="228.0" />
        <di:waypoint x="660" y="228.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="800" y="228.0" />
        <di:waypoint x="850" y="228.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="886" y="228.0" />
        <di:waypoint x="1070" y="138.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_8_di" bpmnElement="flow_8">
        <di:waypoint x="886" y="228.0" />
        <di:waypoint x="1070" y="248.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_9_di" bpmnElement="flow_9">
        <di:waypoint x="886" y="228.0" />
        <di:waypoint x="950" y="390.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_10_di" bpmnElement="flow_10">
        <di:waypoint x="1090" y="390.0" />
        <di:waypoint x="1150" y="388.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_11_di" bpmnElement="flow_11">
        <di:waypoint x="1186" y="388.0" />
        <di:waypoint x="1320" y="338.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_12_di" bpmnElement="flow_12">
        <di:waypoint x="1186" y="388.0" />
        <di:waypoint x="1320" y="448.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>