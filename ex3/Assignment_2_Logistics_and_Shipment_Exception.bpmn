<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns1="http://camunda.org/schema/modeler/1.0" id="A2_Definitions" targetNamespace="https://example.org/bpmn/assignments" exporter="Camunda Modeler" exporterVersion="5.49.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.8.0">
  <bpmn:process id="A2_Shipment_Process" name="Logistics and Shipment Exception Management" isExecutable="false">
    <bpmn:laneSet id="A2_Lanes">
      <bpmn:lane id="A2_MainLane" name="Shipment operations">
        <bpmn:flowNodeRef>A2_Shipment_Process_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_bookingerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_returntransit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_pickerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_returndelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_lostcatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_chargecomp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A2_SupportLane" name="Support / claims">
        <bpmn:flowNodeRef>A2_Shipment_Process_compensate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_refundthrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_bookingclosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_cancelend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_trackmanual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_cancelnotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Shipment_Process_trackerr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A2_Shipment_Process_s" name="Booking started">
      <bpmn:outgoing>A2_Shipment_Process_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A2_Shipment_Process_compensate" name="Record loss and pay compensation">
      <bpmn:incoming>A2_Shipment_Process_Flow_18</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="A2_Shipment_Process_lost" name="Parcel lost">
      <bpmn:incoming>A2_Shipment_Process_Flow_17</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="A2_Shipment_Process_refundthrow" name="Compensate shipment charge">
      <bpmn:incoming>A2_Shipment_Process_Flow_21</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_22</bpmn:outgoing>
      <bpmn:compensateEventDefinition activityRef="A2_Shipment_Process_charge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="A2_Shipment_Process_bookingclosed" name="Closed: invalid booking">
      <bpmn:incoming>A2_Shipment_Process_bookingerrflow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A2_Shipment_Process_cancelend" name="Booking cancelled">
      <bpmn:incoming>A2_Shipment_Process_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A2_Shipment_Process_returned" name="Returned to sender">
      <bpmn:incoming>A2_Shipment_Process_Flow_16</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:subProcess id="A2_booking" name="Book shipment">
      <bpmn:incoming>A2_Shipment_Process_Flow_1</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="A2_booking_b0" name="Start">
        <bpmn:outgoing>A2_booking_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A2_booking_book" name="Shipper enters or corrects booking">
        <bpmn:incoming>A2_booking_Flow_1</bpmn:incoming>
        <bpmn:incoming>A2_booking_retry_yes</bpmn:incoming>
        <bpmn:outgoing>A2_booking_Flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:businessRuleTask id="A2_booking_price" name="Validate address weight and service; calculate charge">
        <bpmn:incoming>A2_booking_Flow_2</bpmn:incoming>
        <bpmn:outgoing>A2_booking_Flow_3</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="A2_booking_valid" name="Booking valid?">
        <bpmn:incoming>A2_booking_Flow_3</bpmn:incoming>
        <bpmn:outgoing>A2_booking_Flow_4</bpmn:outgoing>
        <bpmn:outgoing>A2_booking_Flow_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A2_booking_schedule" name="Schedule pickup and assign driver">
        <bpmn:incoming>A2_booking_Flow_4</bpmn:incoming>
        <bpmn:outgoing>A2_booking_Flow_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="A2_booking_bdone" name="Ready for pickup">
        <bpmn:incoming>A2_booking_Flow_6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A2_booking_Flow_1" sourceRef="A2_booking_b0" targetRef="A2_booking_book" />
      <bpmn:sequenceFlow id="A2_booking_Flow_2" sourceRef="A2_booking_book" targetRef="A2_booking_price" />
      <bpmn:sequenceFlow id="A2_booking_Flow_3" sourceRef="A2_booking_price" targetRef="A2_booking_valid" />
      <bpmn:sequenceFlow id="A2_booking_Flow_4" name="Yes" sourceRef="A2_booking_valid" targetRef="A2_booking_schedule" />
      <bpmn:sequenceFlow id="A2_booking_Flow_5" name="Invalid details" sourceRef="A2_booking_valid" targetRef="A2_booking_retry" />
      <bpmn:sequenceFlow id="A2_booking_Flow_6" sourceRef="A2_booking_schedule" targetRef="A2_booking_bdone" />
      <bpmn:exclusiveGateway id="A2_booking_retry" name="Corrections remaining?">
        <bpmn:incoming>A2_booking_Flow_5</bpmn:incoming>
        <bpmn:outgoing>A2_booking_retry_yes</bpmn:outgoing>
        <bpmn:outgoing>A2_booking_retry_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A2_booking_invalid" name="Invalid after correction limit">
        <bpmn:incoming>A2_booking_retry_no</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A2_error_INVALID_BOOKING" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A2_booking_retry_yes" name="Correction allowed" sourceRef="A2_booking_retry" targetRef="A2_booking_book" />
      <bpmn:sequenceFlow id="A2_booking_retry_no" name="Limit reached" sourceRef="A2_booking_retry" targetRef="A2_booking_invalid" />
    </bpmn:subProcess>
    <bpmn:subProcess id="A2_pickup" name="Collect parcel">
      <bpmn:incoming>A2_Shipment_Process_Flow_2</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_19</bpmn:outgoing>
      <bpmn:startEvent id="A2_pickup_p0" name="Start">
        <bpmn:outgoing>A2_pickup_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A2_pickup_collect" name="Collect parcel and record pickup result">
        <bpmn:documentation>Record whether collection succeeded and increment the failed-pickup count after an unsuccessful attempt.</bpmn:documentation>
        <bpmn:incoming>A2_pickup_Flow_1</bpmn:incoming>
        <bpmn:incoming>A2_pickup_Flow_7</bpmn:incoming>
        <bpmn:outgoing>A2_pickup_Flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A2_pickup_pg" name="Pickup result">
        <bpmn:incoming>A2_pickup_Flow_2</bpmn:incoming>
        <bpmn:outgoing>A2_pickup_Flow_3</bpmn:outgoing>
        <bpmn:outgoing>A2_pickup_Flow_4</bpmn:outgoing>
        <bpmn:outgoing>A2_pickup_Flow_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A2_pickup_packing" name="Check packaging and pickup scan">
        <bpmn:documentation>Record the scan and whether repacking has already been attempted; only one repacking opportunity is allowed.</bpmn:documentation>
        <bpmn:incoming>A2_pickup_Flow_3</bpmn:incoming>
        <bpmn:incoming>A2_pickup_Flow_11</bpmn:incoming>
        <bpmn:outgoing>A2_pickup_Flow_8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A2_pickup_safe" name="Packaging safe?">
        <bpmn:incoming>A2_pickup_Flow_8</bpmn:incoming>
        <bpmn:outgoing>A2_pickup_Flow_9</bpmn:outgoing>
        <bpmn:outgoing>A2_pickup_Flow_10</bpmn:outgoing>
        <bpmn:outgoing>A2_pickup_Flow_12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A2_pickup_pdone" name="Parcel collected">
        <bpmn:incoming>A2_pickup_Flow_9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="A2_pickup_reschedule" name="Reschedule pickup">
        <bpmn:incoming>A2_pickup_Flow_4</bpmn:incoming>
        <bpmn:outgoing>A2_pickup_Flow_6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="A2_pickup_wait" name="Wait until next day">
        <bpmn:incoming>A2_pickup_Flow_6</bpmn:incoming>
        <bpmn:outgoing>A2_pickup_Flow_7</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="A2_pickup_repack" name="Shipper repacks once">
        <bpmn:incoming>A2_pickup_Flow_10</bpmn:incoming>
        <bpmn:outgoing>A2_pickup_Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="A2_pickup_cancelled" name="Cancel pickup">
        <bpmn:incoming>A2_pickup_Flow_5</bpmn:incoming>
        <bpmn:incoming>A2_pickup_Flow_12</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A2_error_CANCEL" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A2_pickup_Flow_1" sourceRef="A2_pickup_p0" targetRef="A2_pickup_collect" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_2" sourceRef="A2_pickup_collect" targetRef="A2_pickup_pg" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_3" name="Collected" sourceRef="A2_pickup_pg" targetRef="A2_pickup_packing" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_4" name="First failure" sourceRef="A2_pickup_pg" targetRef="A2_pickup_reschedule" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_5" name="Second failure" sourceRef="A2_pickup_pg" targetRef="A2_pickup_cancelled" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_6" sourceRef="A2_pickup_reschedule" targetRef="A2_pickup_wait" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_7" sourceRef="A2_pickup_wait" targetRef="A2_pickup_collect" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_8" sourceRef="A2_pickup_packing" targetRef="A2_pickup_safe" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_9" name="Safe" sourceRef="A2_pickup_safe" targetRef="A2_pickup_pdone" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_10" name="First packing issue" sourceRef="A2_pickup_safe" targetRef="A2_pickup_repack" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_11" sourceRef="A2_pickup_repack" targetRef="A2_pickup_packing" />
      <bpmn:sequenceFlow id="A2_pickup_Flow_12" name="Still unsafe" sourceRef="A2_pickup_safe" targetRef="A2_pickup_cancelled" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="A2_Shipment_Process_split" name="Move and update together">
      <bpmn:incoming>A2_Shipment_Process_Flow_20</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>A2_Shipment_Process_Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="A2_transit" name="Transport parcel through each leg">
      <bpmn:incoming>A2_Shipment_Process_Flow_3</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_5</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>= numberOfLegs</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="A2_transit_t0" name="Start">
        <bpmn:outgoing>A2_transit_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A2_transit_scan" name="Sort parcel and record hub scan">
        <bpmn:incoming>A2_transit_Flow_1</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A2_transit_issue" name="Transit issue?">
        <bpmn:incoming>A2_transit_Flow_2</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_4</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_5</bpmn:outgoing>
        <bpmn:outgoing>A2_transit_Flow_6</bpmn:outgoing>
        <bpmn:outgoing>A2_transit_Flow_11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A2_transit_tdone" name="Transport complete">
        <bpmn:incoming>A2_transit_Flow_13</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="A2_transit_scanerr" name="Scan failed" attachedToRef="A2_transit_scan">
        <bpmn:outgoing>A2_transit_Flow_3</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="A2_error_SYSTEM" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A2_transit_manual" name="Supervisor records and reconciles scan">
        <bpmn:incoming>A2_transit_Flow_3</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="A2_transit_claim" name="Inspect damage and agree claim">
        <bpmn:documentation>Inspect damage and insurance. Agree replacement or reshipment where practical; otherwise record a refund or uninsured notice and return the parcel.</bpmn:documentation>
        <bpmn:incoming>A2_transit_Flow_5</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A2_transit_cg" name="Parcel can continue?">
        <bpmn:incoming>A2_transit_Flow_7</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_8</bpmn:outgoing>
        <bpmn:outgoing>A2_transit_Flow_12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="A2_transit_docs" name="Request customs documents">
        <bpmn:incoming>A2_transit_Flow_6</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_22</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_9</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="A2_transit_received" name="Receive corrected documents" messageRef="A2_message_Documents">
        <bpmn:documentation>Wait for documents; the following task checks correctness.</bpmn:documentation>
        <bpmn:incoming>A2_transit_Flow_9</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_19</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="A2_transit_docstime" name="5-day document deadline" attachedToRef="A2_transit_received">
        <bpmn:outgoing>A2_transit_Flow_10</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A2_transit_returnerror" name="Return parcel">
        <bpmn:incoming>A2_transit_Flow_8</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_10</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_23</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A2_error_RETURN" />
      </bpmn:endEvent>
      <bpmn:subProcess id="A2_movement" name="Movement and arrival">
        <bpmn:incoming>A2_transit_Flow_11</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_12</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_21</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_13</bpmn:outgoing>
        <bpmn:startEvent id="A2_movement_m0" name="Departure recorded">
          <bpmn:outgoing>A2_movement_Flow_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="A2_movement_move" name="Move parcel to destination hub">
          <bpmn:incoming>A2_movement_Flow_1</bpmn:incoming>
          <bpmn:outgoing>A2_movement_Flow_2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:eventBasedGateway id="A2_movement_event" name="Arrival or delay?">
          <bpmn:incoming>A2_movement_Flow_2</bpmn:incoming>
          <bpmn:incoming>A2_movement_Flow_9</bpmn:incoming>
          <bpmn:outgoing>A2_movement_Flow_3</bpmn:outgoing>
          <bpmn:outgoing>A2_movement_Flow_4</bpmn:outgoing>
          <bpmn:outgoing>A2_movement_Flow_5</bpmn:outgoing>
        </bpmn:eventBasedGateway>
        <bpmn:intermediateCatchEvent id="A2_movement_arrival" name="Destination scan received">
          <bpmn:incoming>A2_movement_Flow_3</bpmn:incoming>
          <bpmn:outgoing>A2_movement_Flow_6</bpmn:outgoing>
          <bpmn:messageEventDefinition messageRef="A2_message_Arrival" />
        </bpmn:intermediateCatchEvent>
        <bpmn:intermediateCatchEvent id="A2_movement_delay" name="Delay message received">
          <bpmn:incoming>A2_movement_Flow_4</bpmn:incoming>
          <bpmn:outgoing>A2_movement_Flow_7</bpmn:outgoing>
          <bpmn:messageEventDefinition messageRef="A2_message_Delay" />
        </bpmn:intermediateCatchEvent>
        <bpmn:intermediateCatchEvent id="A2_movement_eta" name="ETA exceeded">
          <bpmn:incoming>A2_movement_Flow_5</bpmn:incoming>
          <bpmn:outgoing>A2_movement_Flow_8</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>P1D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:sendTask id="A2_movement_reroute" name="Notify delay and arrange alternate route">
          <bpmn:incoming>A2_movement_Flow_7</bpmn:incoming>
          <bpmn:incoming>A2_movement_Flow_8</bpmn:incoming>
          <bpmn:outgoing>A2_movement_Flow_9</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:endEvent id="A2_movement_mdone" name="Arrival confirmed">
          <bpmn:incoming>A2_movement_Flow_6</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="A2_movement_Flow_1" sourceRef="A2_movement_m0" targetRef="A2_movement_move" />
        <bpmn:sequenceFlow id="A2_movement_Flow_2" sourceRef="A2_movement_move" targetRef="A2_movement_event" />
        <bpmn:sequenceFlow id="A2_movement_Flow_3" sourceRef="A2_movement_event" targetRef="A2_movement_arrival" />
        <bpmn:sequenceFlow id="A2_movement_Flow_4" sourceRef="A2_movement_event" targetRef="A2_movement_delay" />
        <bpmn:sequenceFlow id="A2_movement_Flow_5" sourceRef="A2_movement_event" targetRef="A2_movement_eta" />
        <bpmn:sequenceFlow id="A2_movement_Flow_6" sourceRef="A2_movement_arrival" targetRef="A2_movement_mdone" />
        <bpmn:sequenceFlow id="A2_movement_Flow_7" sourceRef="A2_movement_delay" targetRef="A2_movement_reroute" />
        <bpmn:sequenceFlow id="A2_movement_Flow_8" sourceRef="A2_movement_eta" targetRef="A2_movement_reroute" />
        <bpmn:sequenceFlow id="A2_movement_Flow_9" sourceRef="A2_movement_reroute" targetRef="A2_movement_event" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="A2_transit_missing" name="No scan for 48 hours" attachedToRef="A2_movement">
        <bpmn:outgoing>A2_transit_Flow_14</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>PT48H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A2_transit_trace" name="Trace parcel and confirm arrival">
        <bpmn:incoming>A2_transit_Flow_14</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A2_transit_found" name="Parcel found?">
        <bpmn:incoming>A2_transit_Flow_15</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_16</bpmn:outgoing>
        <bpmn:outgoing>A2_transit_Flow_17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:boundaryEvent id="A2_transit_tracetime" name="Trace exceeds 5 days" attachedToRef="A2_transit_trace">
        <bpmn:outgoing>A2_transit_Flow_18</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A2_transit_losterror" name="Parcel lost">
        <bpmn:incoming>A2_transit_Flow_17</bpmn:incoming>
        <bpmn:incoming>A2_transit_Flow_18</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A2_error_LOST" />
      </bpmn:endEvent>
      <bpmn:userTask id="A2_transit_checkdocs" name="Check documents and record correction count">
        <bpmn:incoming>A2_transit_Flow_19</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A2_transit_docvalid" name="Documents accepted?">
        <bpmn:incoming>A2_transit_Flow_20</bpmn:incoming>
        <bpmn:outgoing>A2_transit_Flow_21</bpmn:outgoing>
        <bpmn:outgoing>A2_transit_Flow_22</bpmn:outgoing>
        <bpmn:outgoing>A2_transit_Flow_23</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="A2_transit_Flow_1" sourceRef="A2_transit_t0" targetRef="A2_transit_scan" />
      <bpmn:sequenceFlow id="A2_transit_Flow_2" sourceRef="A2_transit_scan" targetRef="A2_transit_issue" />
      <bpmn:sequenceFlow id="A2_transit_Flow_3" sourceRef="A2_transit_scanerr" targetRef="A2_transit_manual" />
      <bpmn:sequenceFlow id="A2_transit_Flow_4" sourceRef="A2_transit_manual" targetRef="A2_transit_issue" />
      <bpmn:sequenceFlow id="A2_transit_Flow_5" name="Damaged" sourceRef="A2_transit_issue" targetRef="A2_transit_claim" />
      <bpmn:sequenceFlow id="A2_transit_Flow_6" name="Customs hold" sourceRef="A2_transit_issue" targetRef="A2_transit_docs" />
      <bpmn:sequenceFlow id="A2_transit_Flow_7" sourceRef="A2_transit_claim" targetRef="A2_transit_cg" />
      <bpmn:sequenceFlow id="A2_transit_Flow_8" name="Refund or return" sourceRef="A2_transit_cg" targetRef="A2_transit_returnerror" />
      <bpmn:sequenceFlow id="A2_transit_Flow_9" sourceRef="A2_transit_docs" targetRef="A2_transit_received" />
      <bpmn:sequenceFlow id="A2_transit_Flow_10" sourceRef="A2_transit_docstime" targetRef="A2_transit_returnerror" />
      <bpmn:sequenceFlow id="A2_transit_Flow_11" name="Clear" sourceRef="A2_transit_issue" targetRef="A2_movement" />
      <bpmn:sequenceFlow id="A2_transit_Flow_12" name="Replace or continue" sourceRef="A2_transit_cg" targetRef="A2_movement" />
      <bpmn:sequenceFlow id="A2_transit_Flow_13" sourceRef="A2_movement" targetRef="A2_transit_tdone" />
      <bpmn:sequenceFlow id="A2_transit_Flow_14" sourceRef="A2_transit_missing" targetRef="A2_transit_trace" />
      <bpmn:sequenceFlow id="A2_transit_Flow_15" sourceRef="A2_transit_trace" targetRef="A2_transit_found" />
      <bpmn:sequenceFlow id="A2_transit_Flow_16" name="Yes" sourceRef="A2_transit_found" targetRef="A2_transit_tdone" />
      <bpmn:sequenceFlow id="A2_transit_Flow_17" name="No" sourceRef="A2_transit_found" targetRef="A2_transit_losterror" />
      <bpmn:sequenceFlow id="A2_transit_Flow_18" sourceRef="A2_transit_tracetime" targetRef="A2_transit_losterror" />
      <bpmn:sequenceFlow id="A2_transit_Flow_19" sourceRef="A2_transit_received" targetRef="A2_transit_checkdocs" />
      <bpmn:sequenceFlow id="A2_transit_Flow_20" sourceRef="A2_transit_checkdocs" targetRef="A2_transit_docvalid" />
      <bpmn:sequenceFlow id="A2_transit_Flow_21" name="Yes" sourceRef="A2_transit_docvalid" targetRef="A2_movement" />
      <bpmn:sequenceFlow id="A2_transit_Flow_22" name="One correction" sourceRef="A2_transit_docvalid" targetRef="A2_transit_docs" />
      <bpmn:sequenceFlow id="A2_transit_Flow_23" name="Still invalid" sourceRef="A2_transit_docvalid" targetRef="A2_transit_returnerror" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="A2_Shipment_Process_join" name="Both branches complete">
      <bpmn:incoming>A2_Shipment_Process_Flow_5</bpmn:incoming>
      <bpmn:incoming>A2_Shipment_Process_Flow_6</bpmn:incoming>
      <bpmn:incoming>A2_Shipment_Process_Flow_11</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="A2_delivery" name="Deliver parcel">
      <bpmn:incoming>A2_Shipment_Process_Flow_7</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_8</bpmn:outgoing>
      <bpmn:startEvent id="A2_delivery_d0" name="Start">
        <bpmn:outgoing>A2_delivery_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="A2_delivery_notify" name="Notify recipient of delivery">
        <bpmn:incoming>A2_delivery_Flow_1</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="A2_delivery_handover" name="Deliver parcel and capture proof">
        <bpmn:documentation>Record the delivery outcome and increment the attempt count when the recipient is unavailable.</bpmn:documentation>
        <bpmn:incoming>A2_delivery_Flow_2</bpmn:incoming>
        <bpmn:incoming>A2_delivery_Flow_8</bpmn:incoming>
        <bpmn:incoming>A2_delivery_Flow_18</bpmn:incoming>
        <bpmn:incoming>A2_delivery_Flow_21</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A2_delivery_result" name="Delivery result">
        <bpmn:incoming>A2_delivery_Flow_3</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_4</bpmn:outgoing>
        <bpmn:outgoing>A2_delivery_Flow_5</bpmn:outgoing>
        <bpmn:outgoing>A2_delivery_Flow_6</bpmn:outgoing>
        <bpmn:outgoing>A2_delivery_Flow_13</bpmn:outgoing>
        <bpmn:outgoing>A2_delivery_Flow_15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A2_delivery_evidence" name="Verify delivery proof or recipient receipt">
        <bpmn:documentation>Complete only when delivery proof is recovered or receipt is verified directly with the recipient. Otherwise keep this task open.</bpmn:documentation>
        <bpmn:incoming>A2_delivery_Flow_4</bpmn:incoming>
        <bpmn:incoming>A2_delivery_Flow_11</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="A2_delivery_ddone" name="Delivery confirmed">
        <bpmn:incoming>A2_delivery_Flow_12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="A2_delivery_address" name="Correct address and agree any surcharge">
        <bpmn:incoming>A2_delivery_Flow_5</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="A2_delivery_wait" name="Reattempt next day">
        <bpmn:incoming>A2_delivery_Flow_7</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_8</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="A2_delivery_attempts" name="Fewer than 3 attempts?">
        <bpmn:incoming>A2_delivery_Flow_6</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_7</bpmn:outgoing>
        <bpmn:outgoing>A2_delivery_Flow_9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:receiveTask id="A2_delivery_hold" name="Wait for depot collection" messageRef="A2_message_Collection">
        <bpmn:incoming>A2_delivery_Flow_9</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_10</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:userTask id="A2_delivery_identity" name="Verify collector and record proof">
        <bpmn:incoming>A2_delivery_Flow_10</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A2_delivery_holdtime" name="7-day hold expired" attachedToRef="A2_delivery_hold">
        <bpmn:outgoing>A2_delivery_Flow_14</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A2_delivery_returnerror" name="Return to sender">
        <bpmn:incoming>A2_delivery_Flow_13</bpmn:incoming>
        <bpmn:incoming>A2_delivery_Flow_14</bpmn:incoming>
        <bpmn:incoming>A2_delivery_Flow_19</bpmn:incoming>
        <bpmn:incoming>A2_delivery_Flow_22</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="A2_error_RETURN" />
      </bpmn:endEvent>
      <bpmn:userTask id="A2_delivery_damage" name="Inspect delivery damage and agree claim">
        <bpmn:incoming>A2_delivery_Flow_15</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A2_delivery_damagechoice" name="Replacement agreed?">
        <bpmn:incoming>A2_delivery_Flow_16</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_17</bpmn:outgoing>
        <bpmn:outgoing>A2_delivery_Flow_19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A2_delivery_replace" name="Provide replacement parcel">
        <bpmn:incoming>A2_delivery_Flow_17</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A2_delivery_surcharge" name="Address change agreed?">
        <bpmn:incoming>A2_delivery_Flow_20</bpmn:incoming>
        <bpmn:outgoing>A2_delivery_Flow_21</bpmn:outgoing>
        <bpmn:outgoing>A2_delivery_Flow_22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="A2_delivery_Flow_1" sourceRef="A2_delivery_d0" targetRef="A2_delivery_notify" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_2" sourceRef="A2_delivery_notify" targetRef="A2_delivery_handover" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_3" sourceRef="A2_delivery_handover" targetRef="A2_delivery_result" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_4" name="Delivered" sourceRef="A2_delivery_result" targetRef="A2_delivery_evidence" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_5" name="Wrong address" sourceRef="A2_delivery_result" targetRef="A2_delivery_address" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_6" name="Unavailable" sourceRef="A2_delivery_result" targetRef="A2_delivery_attempts" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_7" name="Yes" sourceRef="A2_delivery_attempts" targetRef="A2_delivery_wait" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_8" sourceRef="A2_delivery_wait" targetRef="A2_delivery_handover" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_9" name="No" sourceRef="A2_delivery_attempts" targetRef="A2_delivery_hold" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_10" sourceRef="A2_delivery_hold" targetRef="A2_delivery_identity" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_11" sourceRef="A2_delivery_identity" targetRef="A2_delivery_evidence" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_12" sourceRef="A2_delivery_evidence" targetRef="A2_delivery_ddone" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_13" name="Refused or COD failed" sourceRef="A2_delivery_result" targetRef="A2_delivery_returnerror" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_14" sourceRef="A2_delivery_holdtime" targetRef="A2_delivery_returnerror" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_15" name="Damaged" sourceRef="A2_delivery_result" targetRef="A2_delivery_damage" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_16" sourceRef="A2_delivery_damage" targetRef="A2_delivery_damagechoice" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_17" name="Yes" sourceRef="A2_delivery_damagechoice" targetRef="A2_delivery_replace" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_18" sourceRef="A2_delivery_replace" targetRef="A2_delivery_handover" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_19" name="No" sourceRef="A2_delivery_damagechoice" targetRef="A2_delivery_returnerror" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_20" sourceRef="A2_delivery_address" targetRef="A2_delivery_surcharge" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_21" name="Yes" sourceRef="A2_delivery_surcharge" targetRef="A2_delivery_handover" />
      <bpmn:sequenceFlow id="A2_delivery_Flow_22" name="No" sourceRef="A2_delivery_surcharge" targetRef="A2_delivery_returnerror" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="A2_Shipment_Process_close" name="Close shipment and issue invoice">
      <bpmn:incoming>A2_Shipment_Process_Flow_8</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="A2_Shipment_Process_done" name="Shipment delivered">
      <bpmn:incoming>A2_Shipment_Process_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="A2_Shipment_Process_tracking" name="Update tracking and notify shipper">
      <bpmn:incoming>A2_Shipment_Process_Flow_4</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="A2_Shipment_Process_trackmanual" name="Supervisor updates tracking manually">
      <bpmn:incoming>A2_Shipment_Process_Flow_10</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="A2_Shipment_Process_cancelnotice" name="Cancel booking and apply fee">
      <bpmn:incoming>A2_Shipment_Process_Flow_12</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A2_Shipment_Process_return" name="Return parcel and adjust return charges">
      <bpmn:documentation>Intercept an in-transit parcel where necessary, return it to the sender, notify the parties and settle charges, without duplicating a cancellation refund already handled by compensation.</bpmn:documentation>
      <bpmn:incoming>A2_Shipment_Process_Flow_14</bpmn:incoming>
      <bpmn:incoming>A2_Shipment_Process_Flow_15</bpmn:incoming>
      <bpmn:incoming>A2_Shipment_Process_Flow_22</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A2_Shipment_Process_charge" name="Record shipment charge">
      <bpmn:incoming>A2_Shipment_Process_Flow_19</bpmn:incoming>
      <bpmn:outgoing>A2_Shipment_Process_Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A2_Shipment_Process_refund" name="Refund charge minus cancellation fee" isForCompensation="true" />
    <bpmn:boundaryEvent id="A2_Shipment_Process_bookingerr" name="Invalid booking" attachedToRef="A2_booking">
      <bpmn:outgoing>A2_Shipment_Process_bookingerrflow</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="A2_error_INVALID_BOOKING" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A2_Shipment_Process_returntransit" name="Return required" attachedToRef="A2_transit">
      <bpmn:outgoing>A2_Shipment_Process_Flow_14</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="A2_error_RETURN" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A2_Shipment_Process_trackerr" name="Tracking failed" attachedToRef="A2_Shipment_Process_tracking">
      <bpmn:outgoing>A2_Shipment_Process_Flow_10</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="A2_error_SYSTEM" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A2_Shipment_Process_pickerr" name="Pickup cancelled" attachedToRef="A2_pickup">
      <bpmn:outgoing>A2_Shipment_Process_Flow_12</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="A2_error_CANCEL" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A2_Shipment_Process_returndelivery" name="Return required" attachedToRef="A2_delivery">
      <bpmn:outgoing>A2_Shipment_Process_Flow_15</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="A2_error_RETURN" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A2_Shipment_Process_cancel" name="Cancellation received" attachedToRef="A2_transit">
      <bpmn:outgoing>A2_Shipment_Process_Flow_21</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="A2_message_Cancellation" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A2_Shipment_Process_lostcatch" name="Lost after tracing" attachedToRef="A2_transit">
      <bpmn:outgoing>A2_Shipment_Process_Flow_18</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="A2_error_LOST" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A2_Shipment_Process_chargecomp" name="Compensation" cancelActivity="false" attachedToRef="A2_Shipment_Process_charge">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_1" sourceRef="A2_Shipment_Process_s" targetRef="A2_booking" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_18" sourceRef="A2_Shipment_Process_lostcatch" targetRef="A2_Shipment_Process_compensate" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_17" sourceRef="A2_Shipment_Process_compensate" targetRef="A2_Shipment_Process_lost" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_21" sourceRef="A2_Shipment_Process_cancel" targetRef="A2_Shipment_Process_refundthrow" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_22" sourceRef="A2_Shipment_Process_refundthrow" targetRef="A2_Shipment_Process_return" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_bookingerrflow" sourceRef="A2_Shipment_Process_bookingerr" targetRef="A2_Shipment_Process_bookingclosed" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_13" sourceRef="A2_Shipment_Process_cancelnotice" targetRef="A2_Shipment_Process_cancelend" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_16" sourceRef="A2_Shipment_Process_return" targetRef="A2_Shipment_Process_returned" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_2" sourceRef="A2_booking" targetRef="A2_pickup" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_19" sourceRef="A2_pickup" targetRef="A2_Shipment_Process_charge" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_20" sourceRef="A2_Shipment_Process_charge" targetRef="A2_Shipment_Process_split" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_3" sourceRef="A2_Shipment_Process_split" targetRef="A2_transit" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_4" sourceRef="A2_Shipment_Process_split" targetRef="A2_Shipment_Process_tracking" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_5" sourceRef="A2_transit" targetRef="A2_Shipment_Process_join" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_6" sourceRef="A2_Shipment_Process_tracking" targetRef="A2_Shipment_Process_join" />
    <bpmn:sequenceFlow id="A2_Shipment_Process_Flow_11" sourceRef="A2_Shipment_Process_trackmanual" targetRef="A2_Shipment_Process_join" />
