<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_ShipmentExceptionManagement" targetNamespace="https://example.org/camunda8/bpmn" exporter="Camunda Modeler" exporterVersion="5.XX">
  <bpmn:collaboration id="Collaboration_ShipmentExceptionManagement">
    <bpmn:participant id="Participant_Main" name="Shipment Lifecycle and Exception Handling" processRef="Process_ShipmentLifecycle" />
  </bpmn:collaboration>
  <bpmn:message id="Message_CustomsDocuments" name="shipment-customs-documents">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_DelayAlert" name="shipment-delay-reported">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ArrivalScan" name="shipment-arrival-scan">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_CancelShipment" name="shipment-cancel-after-dispatch">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ParcelFound" name="shipment-found">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Redelivery" name="shipment-redelivery-requested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_ScanFailure" name="Scan service unavailable or inconsistent" errorCode="SCAN_UNAVAILABLE" />
  <bpmn:process id="Process_ShipmentLifecycle" name="Logistics &amp; Shipment Exception Management" isExecutable="true">
    <bpmn:laneSet id="LaneSet_ShipmentExceptionManagement">
      <bpmn:lane id="Lane_Shipper" name="Shipper / Customer">
        <bpmn:flowNodeRef>Start_Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Book_Shipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Correct_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive_CustomsDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_CustomsDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_CancelShipment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Control" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>Schedule_Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pickup_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Count_PickupFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pickup_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reschedule_Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_DelayAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Trace_Shipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reroute_Alternate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Stop_Movement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pickup" name="Pickup Agent">
        <bpmn:flowNodeRef>Collect_Parcel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>Hub_Sort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Record_HubScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Scan_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Manual_HubScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inspect_Parcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Damage_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare_Reship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dispatch_Linehaul</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_ParcelFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return_Sender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hold_Depot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return_Refused</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Delivery Agent">
        <bpmn:flowNodeRef>Deliver_Parcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Contact_Address</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recipient" name="Recipient">
        <bpmn:flowNodeRef>Catch_Redelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm_Address</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:flowNodeRef>Assess_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Claim_Remedy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Apply_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Declare_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Lost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Tracking / Shipment System">
        <bpmn:flowNodeRef>Validate_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Booking_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Count_BookingFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Booking_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BookingInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Charge_Shipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Compensation_Charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refund_ShipmentFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PickupCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Init_Transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reconcile_Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check_Insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Insurance_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Set_ClaimClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Report_UninsuredDamage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Uninsured_Fit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Set_ReturnOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Customs_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request_CustomsDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Set_CustomsReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transit_EventChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_DelayTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check_ScanAge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Lost_Threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Trace_EventChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_TraceExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Set_LostOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Update_ETA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>More_Hubs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Set_CancelOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Compensate_Fee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Record_MovementComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tracking_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transit_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClaimClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Out_ForDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivery_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Close_Invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Count_Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivery_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Depot_EventChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_DepotExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return_Charges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Address_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Calculate_Surcharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Uninsured_Stage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Claim_RefundStage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Claim_ReshipStage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Claim_ReturnStage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DeliveryDamage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Book" name="Shipper books a shipment">
      <bpmn:outgoing>G_StartBooking</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Book_Shipment" name="Create shipment booking">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_StartBooking</bpmn:incoming>
      <bpmn:outgoing>G_BookValidation</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Validate_Booking" name="Validate address, weight and service level">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-shipment-booking" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_BookValidation</bpmn:incoming>
      <bpmn:outgoing>G_BookingGateway</bpmn:outgoing>
      <bpmn:incoming>G_CorrectAgain</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Booking_Valid" name="Booking details valid?" default="G_BookingInvalid">
      <bpmn:incoming>G_BookingGateway</bpmn:incoming>
      <bpmn:outgoing>G_BookingGood</bpmn:outgoing>
      <bpmn:outgoing>G_BookingAddress</bpmn:outgoing>
      <bpmn:outgoing>G_BookingInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Correct_Booking" name="Correct address or shipment details">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_BookingAddress</bpmn:incoming>
      <bpmn:outgoing>G_CorrectCount</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Count_BookingFix" name="Count booking correction">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="count-booking-correction" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_CorrectCount</bpmn:incoming>
      <bpmn:outgoing>G_CorrectCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Booking_Attempts" name="F2: fewer than 2 corrections?" default="G_BookingClosed">
      <bpmn:incoming>G_CorrectCheck</bpmn:incoming>
      <bpmn:outgoing>G_CorrectAgain</bpmn:outgoing>
      <bpmn:outgoing>G_BookingClosed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_BookingInvalid" name="Closed: invalid booking">
      <bpmn:incoming>G_BookingInvalid</bpmn:incoming>
      <bpmn:incoming>G_BookingClosed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Charge_Shipment" name="Calculate and charge shipment fee">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-shipment-fee" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_BookingGood</bpmn:incoming>
      <bpmn:outgoing>G_ChargeSchedule</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Compensation_Charge" name="Shipment-fee compensation handler" attachedToRef="Charge_Shipment" cancelActivity="false">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Refund_ShipmentFee" name="Refund fee less dispatch charge" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="refund-shipment-fee-less-dispatch" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Schedule_Pickup" name="Schedule pickup and assign driver">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="schedule-pickup" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ChargeSchedule</bpmn:incoming>
      <bpmn:outgoing>G_SchedulePickup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Collect_Parcel" name="Collect parcel and scan pickup">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_SchedulePickup</bpmn:incoming>
      <bpmn:outgoing>G_PickupOutcome</bpmn:outgoing>
      <bpmn:incoming>G_RescheduleAgain</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Pickup_Success" name="Parcel collected and ready?" default="G_PickupFail">
      <bpmn:incoming>G_PickupOutcome</bpmn:incoming>
      <bpmn:outgoing>G_PickupCollected</bpmn:outgoing>
      <bpmn:outgoing>G_PickupFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Count_PickupFailure" name="Count pickup attempt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="count-pickup-attempt" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_PickupFail</bpmn:incoming>
      <bpmn:outgoing>G_PickupCount</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Pickup_Attempts" name="F1: fewer than 3 attempts?" default="G_PickupClosed">
      <bpmn:incoming>G_PickupCount</bpmn:incoming>
      <bpmn:outgoing>G_PickupRetry</bpmn:outgoing>
      <bpmn:outgoing>G_PickupClosed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Reschedule_Pickup" name="Reschedule pickup">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reschedule-pickup" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_PickupRetry</bpmn:incoming>
      <bpmn:outgoing>G_RescheduleAgain</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Cancel_Booking" name="Cancel booking and apply fee">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cancel-shipment-booking" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_PickupClosed</bpmn:incoming>
      <bpmn:outgoing>G_CancelPickupEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_PickupCancelled" name="Closed: pickup failed">
      <bpmn:incoming>G_CancelPickupEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Init_Transit" name="Initialize transit status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="initialize-transit-status" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_PickupCollected</bpmn:incoming>
      <bpmn:outgoing>G_InitSplit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Split_Transit" name="Move parcel and update tracking in parallel">
      <bpmn:incoming>G_InitSplit</bpmn:incoming>
      <bpmn:outgoing>G_SplitMovement</bpmn:outgoing>
      <bpmn:outgoing>G_SplitTracking</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Hub_Sort" name="Sort parcel through hub network">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="sort-through-hubs" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_SplitMovement</bpmn:incoming>
      <bpmn:outgoing>G_HubSortScan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Record_HubScan" name="Record hub arrival scan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-hub-scan" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_HubSortScan</bpmn:incoming>
      <bpmn:outgoing>G_ScanInspect</bpmn:outgoing>
      <bpmn:incoming>G_TraceFoundScan</bpmn:incoming>
      <bpmn:incoming>G_ArrivalScan</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Scan_Error" name="E9: scanner or data mismatch" attachedToRef="Record_HubScan" cancelActivity="true">
      <bpmn:outgoing>G_ScanError</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_ScanFailure" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Manual_HubScan" name="Supervisor records scan manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ScanError</bpmn:incoming>
      <bpmn:outgoing>G_ManualReconcile</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Reconcile_Scan" name="Reconcile hub and tracking records">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reconcile-shipment-scan" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ManualReconcile</bpmn:incoming>
      <bpmn:outgoing>G_ReconcileInspect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Inspect_Parcel" name="Inspect parcel condition at hub">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inspect-parcel-condition" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ReconcileInspect</bpmn:incoming>
      <bpmn:incoming>G_ScanInspect</bpmn:incoming>
      <bpmn:outgoing>G_InspectDamage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Damage_Found" name="E3: damage found?" default="G_NotDamaged">
      <bpmn:incoming>G_InspectDamage</bpmn:incoming>
      <bpmn:outgoing>G_NotDamaged</bpmn:outgoing>
      <bpmn:outgoing>G_Damaged</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Check_Insurance" name="Check shipment insurance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-shipment-insurance" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_Damaged</bpmn:incoming>
      <bpmn:outgoing>G_InsuranceCheck</bpmn:outgoing>
      <bpmn:incoming>G_DeliveryDamage</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Insurance_Decision" name="Insured?" default="G_Uninsured">
      <bpmn:incoming>G_InsuranceCheck</bpmn:incoming>
      <bpmn:outgoing>G_Insured</bpmn:outgoing>
      <bpmn:outgoing>G_Uninsured</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Assess_Claim" name="Assess damage claim and choose remedy">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_Insured</bpmn:incoming>
      <bpmn:outgoing>G_ClaimDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Claim_Remedy" name="Claim remedy?" default="G_ClaimReturn">
      <bpmn:incoming>G_ClaimDecision</bpmn:incoming>
      <bpmn:outgoing>G_ClaimReship</bpmn:outgoing>
      <bpmn:outgoing>G_ClaimRefund</bpmn:outgoing>
      <bpmn:outgoing>G_ClaimReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Apply_Refund" name="Process claim refund">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-claim-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ClaimRefund</bpmn:incoming>
      <bpmn:outgoing>G_ClaimRefundSet</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Set_ClaimClosed" name="Set shipment outcome to claim closed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-shipment-outcome-claim-closed" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ClaimRefundSet</bpmn:incoming>
      <bpmn:outgoing>G_ClaimRefundStage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Prepare_Reship" name="Repackage or prepare replacement shipment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepare-reshipment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ClaimReship</bpmn:incoming>
      <bpmn:incoming>G_UninsuredContinue</bpmn:incoming>
      <bpmn:outgoing>G_ReshipStage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Report_UninsuredDamage" name="Record damage and notify shipper">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-uninsured-damage" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_Uninsured</bpmn:incoming>
      <bpmn:outgoing>G_UninsuredReport</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Uninsured_Fit" name="Safe to continue shipment?" default="G_UninsuredReturn">
      <bpmn:incoming>G_UninsuredHub</bpmn:incoming>
      <bpmn:outgoing>G_UninsuredContinue</bpmn:outgoing>
      <bpmn:outgoing>G_UninsuredReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Set_ReturnOutcome" name="Set shipment outcome to return">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-shipment-outcome-return" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ClaimReturnHub</bpmn:incoming>
      <bpmn:incoming>G_UninsuredReturn</bpmn:incoming>
      <bpmn:outgoing>G_SetReturnTransitComplete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Customs_Check" name="E6: international customs required?" default="G_CustomsNotRequired">
      <bpmn:incoming>G_NotDamaged</bpmn:incoming>
      <bpmn:incoming>G_ReshipHub</bpmn:incoming>
      <bpmn:outgoing>G_CustomsRequired</bpmn:outgoing>
      <bpmn:outgoing>G_CustomsNotRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Request_CustomsDocs" name="Request export / import documents">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-customs-documents" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_CustomsRequired</bpmn:incoming>
      <bpmn:outgoing>G_CustomsDocsWait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Receive_CustomsDocs" name="Receive customs documents" messageRef="Message_CustomsDocuments">
      <bpmn:incoming>G_CustomsDocsWait</bpmn:incoming>
      <bpmn:outgoing>G_CustomsDocsReceived</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Timer_CustomsDeadline" name="E6: customs documents due in 5 days" attachedToRef="Receive_CustomsDocs" cancelActivity="true">
      <bpmn:outgoing>G_CustomsExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Return_Customs" name="Return parcel to origin after customs hold">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-after-customs-hold" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_CustomsExpired</bpmn:incoming>
      <bpmn:outgoing>G_CustomsSetReturn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Set_CustomsReturn" name="Set outcome to return">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-shipment-outcome-return" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_CustomsSetReturn</bpmn:incoming>
      <bpmn:outgoing>G_CustomsToTransitComplete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Dispatch_Linehaul" name="Dispatch line-haul to next hub">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dispatch-linehaul" retries="3" />
      </bpmn:extensionElements>
      <bpmn:outgoing>G_DispatchWait</bpmn:outgoing>
      <bpmn:incoming>G_MoreHubLegs</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Transit_EventChoice" name="E5 / E4 / E10: wait for movement event">
      <bpmn:incoming>G_DispatchWait</bpmn:incoming>
      <bpmn:outgoing>G_WaitDelayMsg</bpmn:outgoing>
      <bpmn:outgoing>G_WaitDelayTimer</bpmn:outgoing>
      <bpmn:outgoing>G_WaitArrival</bpmn:outgoing>
      <bpmn:outgoing>G_WaitCancel</bpmn:outgoing>
      <bpmn:incoming>G_UpdatedETAWait</bpmn:incoming>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_DelayAlert" name="E5: carrier reports delay">
      <bpmn:incoming>G_WaitDelayMsg</bpmn:incoming>
      <bpmn:outgoing>G_DelayMsgNotify</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_DelayAlert" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DelayTimer" name="E5: 6-hour no-update timer">
      <bpmn:incoming>G_WaitDelayTimer</bpmn:incoming>
      <bpmn:outgoing>G_DelayTimerCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT6H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Check_ScanAge" name="Check time since last scan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-last-scan-age" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_DelayTimerCheck</bpmn:incoming>
      <bpmn:outgoing>G_ScanAgeDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Lost_Threshold" name="E4: no scan for 48 hours?" default="G_NotLostDelay">
      <bpmn:incoming>G_ScanAgeDecision</bpmn:incoming>
      <bpmn:outgoing>G_NotLostDelay</bpmn:outgoing>
      <bpmn:outgoing>G_LostTrace</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Trace_Shipment" name="Trace shipment with hubs and carrier">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="trace-shipment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_LostTrace</bpmn:incoming>
      <bpmn:outgoing>G_TraceWait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Trace_EventChoice" name="Parcel found within 5 days?">
      <bpmn:incoming>G_TraceWait</bpmn:incoming>
      <bpmn:outgoing>G_TraceFound</bpmn:outgoing>
      <bpmn:outgoing>G_TraceExpire</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_ParcelFound" name="Parcel located">
      <bpmn:incoming>G_TraceFound</bpmn:incoming>
      <bpmn:outgoing>G_TraceFoundScan</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ParcelFound" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_TraceExpired" name="E4: 5-day tracing timer">
      <bpmn:incoming>G_TraceExpire</bpmn:incoming>
      <bpmn:outgoing>G_TraceLostDeclare</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Declare_Lost" name="Declare shipment lost and compensate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="declare-lost-and-compensate" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_TraceLostDeclare</bpmn:incoming>
      <bpmn:outgoing>G_DeclareLostSet</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Set_LostOutcome" name="Set shipment outcome to lost">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-shipment-outcome-lost" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_DeclareLostSet</bpmn:incoming>
      <bpmn:outgoing>G_LostToComplete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Notify_Delay" name="Notify shipper / recipient of delay">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-shipment-delay" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_DelayMsgNotify</bpmn:incoming>
      <bpmn:incoming>G_NotLostDelay</bpmn:incoming>
      <bpmn:outgoing>G_DelayReroute</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Reroute_Alternate" name="Reroute or assign alternate vehicle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reroute-shipment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_DelayReroute</bpmn:incoming>
      <bpmn:outgoing>G_RerouteETA</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Update_ETA" name="Update estimated delivery time">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-shipment-eta" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_RerouteETA</bpmn:incoming>
      <bpmn:outgoing>G_UpdatedETAWait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Catch_Arrival" name="Parcel arrives at next hub">
      <bpmn:incoming>G_WaitArrival</bpmn:incoming>
      <bpmn:outgoing>G_ArrivalScan</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ArrivalScan" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_CancelShipment" name="E10: shipper cancels after dispatch">
      <bpmn:incoming>G_WaitCancel</bpmn:incoming>
      <bpmn:outgoing>G_CancelCatchStop</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CancelShipment" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="More_Hubs" name="More hub legs remain?" default="G_DoneHubs">
      <bpmn:incoming>G_CustomsDocsReceived</bpmn:incoming>
      <bpmn:incoming>G_CustomsNotRequired</bpmn:incoming>
      <bpmn:outgoing>G_MoreHubLegs</bpmn:outgoing>
      <bpmn:outgoing>G_DoneHubs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Set_CancelOutcome" name="Set shipment outcome to cancelled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-shipment-outcome-cancelled" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_CancelCompSet</bpmn:incoming>
      <bpmn:outgoing>G_CancelOutcomePublish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Stop_Movement" name="Stop movement and request interception">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="stop-shipment-movement" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_CancelCatchStop</bpmn:incoming>
      <bpmn:outgoing>G_CancelStopReturn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Return_Cancelled" name="Return cancelled parcel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-cancelled-shipment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_CancelStopReturn</bpmn:incoming>
      <bpmn:outgoing>G_CancelReturnComp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Compensate_Fee" name="E10: refund shipment fee less dispatch charge">
      <bpmn:incoming>G_CancelReturnComp</bpmn:incoming>
      <bpmn:outgoing>G_CancelCompSet</bpmn:outgoing>
      <bpmn:compensateEventDefinition activityRef="Charge_Shipment" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Record_MovementComplete" name="Record transit outcome and complete movement branch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-transit-outcome" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_RefundHub</bpmn:incoming>
      <bpmn:incoming>G_SetReturnTransitComplete</bpmn:incoming>
      <bpmn:incoming>G_CustomsToTransitComplete</bpmn:incoming>
      <bpmn:incoming>G_LostToComplete</bpmn:incoming>
      <bpmn:incoming>G_DoneHubs</bpmn:incoming>
      <bpmn:incoming>G_CancelOutcomePublish</bpmn:incoming>
      <bpmn:outgoing>G_TransitJoinMovement</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Tracking_Update" name="Publish pickup tracking scan and notify shipper">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-pickup-tracking" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_SplitTracking</bpmn:incoming>
      <bpmn:outgoing>G_TrackingJoin</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Join_Transit" name="Movement and tracking complete">
      <bpmn:incoming>G_TrackingJoin</bpmn:incoming>
      <bpmn:incoming>G_TransitJoinMovement</bpmn:incoming>
      <bpmn:outgoing>G_JoinOutcome</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Transit_Outcome" name="Transit outcome?" default="G_TransitContinue">
      <bpmn:incoming>G_JoinOutcome</bpmn:incoming>
      <bpmn:outgoing>G_TransitLost</bpmn:outgoing>
      <bpmn:outgoing>G_TransitReturn</bpmn:outgoing>
      <bpmn:outgoing>G_TransitClaim</bpmn:outgoing>
      <bpmn:outgoing>G_TransitCancelled</bpmn:outgoing>
      <bpmn:outgoing>G_TransitContinue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Notify_Lost" name="Notify customer and record loss">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer-of-loss" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_TransitLost</bpmn:incoming>
      <bpmn:outgoing>G_LostNotifyEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Lost" name="Closed: lost and compensated">
      <bpmn:incoming>G_LostNotifyEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Return_Sender" name="Return shipment to sender">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-to-sender" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ClaimReturnDelivery</bpmn:incoming>
      <bpmn:incoming>G_TransitReturn</bpmn:incoming>
      <bpmn:outgoing>G_ReturnEnd</bpmn:outgoing>
      <bpmn:incoming>G_AddressDenied</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Returned" name="Closed: returned to sender">
      <bpmn:incoming>G_ReturnEnd</bpmn:incoming>
      <bpmn:incoming>G_ExpiredReturnEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ClaimClosed" name="Closed: claim refunded">
      <bpmn:incoming>G_RefundDelivery</bpmn:incoming>
      <bpmn:incoming>G_TransitClaim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancelled" name="Closed: cancelled after dispatch">
      <bpmn:incoming>G_TransitCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Out_ForDelivery" name="Dispatch last-mile delivery and notify recipient">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dispatch-last-mile" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ReshipDelivery</bpmn:incoming>
      <bpmn:incoming>G_TransitContinue</bpmn:incoming>
      <bpmn:outgoing>G_OutDeliveryUser</bpmn:outgoing>
      <bpmn:incoming>G_RetryDelivery</bpmn:incoming>
      <bpmn:incoming>G_Redeliver</bpmn:incoming>
      <bpmn:incoming>G_AddressRevisedDelivery</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:userTask id="Deliver_Parcel" name="Deliver parcel and capture proof">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_OutDeliveryUser</bpmn:incoming>
      <bpmn:outgoing>G_DeliveryChoice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Delivery_Outcome" name="Delivery result?" default="G_Unavailable">
      <bpmn:incoming>G_DeliveryChoice</bpmn:incoming>
      <bpmn:outgoing>G_Delivered</bpmn:outgoing>
      <bpmn:outgoing>G_Unavailable</bpmn:outgoing>
      <bpmn:outgoing>G_Refusal</bpmn:outgoing>
      <bpmn:outgoing>G_AddressProblem</bpmn:outgoing>
      <bpmn:outgoing>G_DeliveryDamage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Close_Invoice" name="Close shipment and generate invoice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-shipment-and-invoice" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_Delivered</bpmn:incoming>
      <bpmn:outgoing>G_InvoiceEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Delivered" name="Closed: delivered">
      <bpmn:incoming>G_InvoiceEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Count_Delivery" name="Count delivery attempt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="count-delivery-attempt" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_Unavailable</bpmn:incoming>
      <bpmn:outgoing>G_CountDelivery</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Delivery_Attempts" name="E7: fewer than 3 attempts?" default="G_HoldDepot">
      <bpmn:incoming>G_CountDelivery</bpmn:incoming>
      <bpmn:outgoing>G_RetryDelivery</bpmn:outgoing>
      <bpmn:outgoing>G_HoldDepot</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Hold_Depot" name="Hold parcel at depot for 7 days">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hold-at-depot" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_HoldDepot</bpmn:incoming>
      <bpmn:outgoing>G_HoldWait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Depot_EventChoice" name="Recipient response or depot deadline?">
      <bpmn:incoming>G_HoldWait</bpmn:incoming>
      <bpmn:outgoing>G_DepotReroute</bpmn:outgoing>
      <bpmn:outgoing>G_DepotExpired</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Redelivery" name="Recipient requests redelivery">
      <bpmn:incoming>G_DepotReroute</bpmn:incoming>
      <bpmn:outgoing>G_Redeliver</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Redelivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DepotExpired" name="7-day depot hold expires">
      <bpmn:incoming>G_DepotExpired</bpmn:incoming>
      <bpmn:outgoing>G_ExpiredReturn</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Return_Expired" name="Return unclaimed parcel to sender">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-unclaimed-parcel" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ExpiredReturn</bpmn:incoming>
      <bpmn:outgoing>G_ExpiredReturnEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Return_Charges" name="Adjust refusal / COD charges">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="adjust-return-charges" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_Refusal</bpmn:incoming>
      <bpmn:outgoing>G_RefusalReturn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Return_Refused" name="E8: return refused / unpaid COD parcel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-refused-shipment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_RefusalReturn</bpmn:incoming>
      <bpmn:outgoing>G_RefusalEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Refused" name="Closed: refused / COD failed">
      <bpmn:incoming>G_RefusalEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Contact_Address" name="E2: contact recipient about address">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_AddressProblem</bpmn:incoming>
      <bpmn:outgoing>G_ContactConfirm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Confirm_Address" name="Confirm corrected delivery address">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>G_ContactConfirm</bpmn:incoming>
      <bpmn:outgoing>G_AddressApproval</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Address_Approved" name="Address change and surcharge approved?" default="G_AddressDenied">
      <bpmn:incoming>G_AddressApproval</bpmn:incoming>
      <bpmn:outgoing>G_AddressApproved</bpmn:outgoing>
      <bpmn:outgoing>G_AddressDenied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Calculate_Surcharge" name="Calculate address-change surcharge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-address-surcharge" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>G_AddressApproved</bpmn:incoming>
      <bpmn:outgoing>G_AddressRevisedDelivery</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Uninsured_Stage" name="Damage claim at hub or doorstep?" default="G_UninsuredHub">
      <bpmn:incoming>G_UninsuredReport</bpmn:incoming>
      <bpmn:outgoing>G_UninsuredDoorstep</bpmn:outgoing>
      <bpmn:outgoing>G_UninsuredHub</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Claim_RefundStage" name="Refund claim at hub or doorstep?" default="G_RefundHub">
      <bpmn:incoming>G_ClaimRefundStage</bpmn:incoming>
      <bpmn:outgoing>G_RefundHub</bpmn:outgoing>
      <bpmn:outgoing>G_RefundDelivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Claim_ReshipStage" name="Reship claim at hub or doorstep?" default="G_ReshipHub">
      <bpmn:incoming>G_ReshipStage</bpmn:incoming>
      <bpmn:outgoing>G_ReshipHub</bpmn:outgoing>
      <bpmn:outgoing>G_ReshipDelivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Claim_ReturnStage" name="Return claim at hub or doorstep?" default="G_ClaimReturnHub">
      <bpmn:incoming>G_ClaimReturn</bpmn:incoming>
      <bpmn:outgoing>G_ClaimReturnDelivery</bpmn:outgoing>
      <bpmn:outgoing>G_ClaimReturnHub</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_DeliveryDamage" name="Closed: uninsured delivery damage recorded">
      <bpmn:incoming>G_UninsuredDoorstep</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="G_StartBooking" sourceRef="Start_Book" targetRef="Book_Shipment" />
    <bpmn:sequenceFlow id="G_BookValidation" sourceRef="Book_Shipment" targetRef="Validate_Booking" />
    <bpmn:sequenceFlow id="G_BookingGateway" sourceRef="Validate_Booking" targetRef="Booking_Valid" />
    <bpmn:sequenceFlow id="G_BookingGood" sourceRef="Booking_Valid" targetRef="Charge_Shipment" name="Booking valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= bookingValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_BookingAddress" sourceRef="Booking_Valid" targetRef="Correct_Booking" name="E2: address/details need correction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= bookingValid = false and bookingIssue != "nonCorrectable"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_BookingInvalid" sourceRef="Booking_Valid" targetRef="End_BookingInvalid" name="Invalid after permitted corrections" />
    <bpmn:sequenceFlow id="G_CorrectCount" sourceRef="Correct_Booking" targetRef="Count_BookingFix" />
    <bpmn:sequenceFlow id="G_CorrectCheck" sourceRef="Count_BookingFix" targetRef="Booking_Attempts" />
    <bpmn:sequenceFlow id="G_CorrectAgain" sourceRef="Booking_Attempts" targetRef="Validate_Booking" name="Corrections remain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= bookingCorrections &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_BookingClosed" sourceRef="Booking_Attempts" targetRef="End_BookingInvalid" name="Correction limit reached" />
    <bpmn:sequenceFlow id="G_ChargeSchedule" sourceRef="Charge_Shipment" targetRef="Schedule_Pickup" />
    <bpmn:sequenceFlow id="G_SchedulePickup" sourceRef="Schedule_Pickup" targetRef="Collect_Parcel" />
    <bpmn:sequenceFlow id="G_PickupOutcome" sourceRef="Collect_Parcel" targetRef="Pickup_Success" />
    <bpmn:sequenceFlow id="G_PickupCollected" sourceRef="Pickup_Success" targetRef="Init_Transit" name="Parcel ready">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pickupOutcome = "collected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_PickupFail" sourceRef="Pickup_Success" targetRef="Count_PickupFailure" name="Absent / not ready" />
    <bpmn:sequenceFlow id="G_PickupCount" sourceRef="Count_PickupFailure" targetRef="Pickup_Attempts" />
    <bpmn:sequenceFlow id="G_PickupRetry" sourceRef="Pickup_Attempts" targetRef="Reschedule_Pickup" name="Reschedule within two retries">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pickupAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_RescheduleAgain" sourceRef="Reschedule_Pickup" targetRef="Collect_Parcel" />
    <bpmn:sequenceFlow id="G_PickupClosed" sourceRef="Pickup_Attempts" targetRef="Cancel_Booking" name="Pickup exhausted" />
    <bpmn:sequenceFlow id="G_CancelPickupEnd" sourceRef="Cancel_Booking" targetRef="End_PickupCancelled" />
    <bpmn:sequenceFlow id="G_InitSplit" sourceRef="Init_Transit" targetRef="Split_Transit" />
    <bpmn:sequenceFlow id="G_SplitMovement" sourceRef="Split_Transit" targetRef="Hub_Sort" name="Physical movement" />
    <bpmn:sequenceFlow id="G_SplitTracking" sourceRef="Split_Transit" targetRef="Tracking_Update" name="Tracking update" />
    <bpmn:sequenceFlow id="G_HubSortScan" sourceRef="Hub_Sort" targetRef="Record_HubScan" />
    <bpmn:sequenceFlow id="G_ScanError" sourceRef="Scan_Error" targetRef="Manual_HubScan" />
    <bpmn:sequenceFlow id="G_ManualReconcile" sourceRef="Manual_HubScan" targetRef="Reconcile_Scan" />
    <bpmn:sequenceFlow id="G_ReconcileInspect" sourceRef="Reconcile_Scan" targetRef="Inspect_Parcel" />
    <bpmn:sequenceFlow id="G_ScanInspect" sourceRef="Record_HubScan" targetRef="Inspect_Parcel" />
    <bpmn:sequenceFlow id="G_InspectDamage" sourceRef="Inspect_Parcel" targetRef="Damage_Found" />
    <bpmn:sequenceFlow id="G_NotDamaged" sourceRef="Damage_Found" targetRef="Customs_Check" name="Parcel intact" />
    <bpmn:sequenceFlow id="G_Damaged" sourceRef="Damage_Found" targetRef="Check_Insurance" name="Parcel damaged">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= damageFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_InsuranceCheck" sourceRef="Check_Insurance" targetRef="Insurance_Decision" />
    <bpmn:sequenceFlow id="G_Insured" sourceRef="Insurance_Decision" targetRef="Assess_Claim" name="Insured">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= insured = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_Uninsured" sourceRef="Insurance_Decision" targetRef="Report_UninsuredDamage" name="Not insured" />
    <bpmn:sequenceFlow id="G_ClaimDecision" sourceRef="Assess_Claim" targetRef="Claim_Remedy" />
    <bpmn:sequenceFlow id="G_ClaimReship" sourceRef="Claim_Remedy" targetRef="Prepare_Reship" name="Replacement / reship">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= claimRemedy = "reship" or claimRemedy = "replacement"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_ClaimRefund" sourceRef="Claim_Remedy" targetRef="Apply_Refund" name="Refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= claimRemedy = "refund"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_ClaimRefundSet" sourceRef="Apply_Refund" targetRef="Set_ClaimClosed" />
    <bpmn:sequenceFlow id="G_ClaimRefundStage" sourceRef="Set_ClaimClosed" targetRef="Claim_RefundStage" />
    <bpmn:sequenceFlow id="G_RefundHub" sourceRef="Claim_RefundStage" targetRef="Record_MovementComplete" name="Hub claim closes transit branch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= damageStage = "hub"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_RefundDelivery" sourceRef="Claim_RefundStage" targetRef="End_ClaimClosed" name="Doorstep claim is settled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= damageStage = "delivery"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_ClaimReturn" sourceRef="Claim_Remedy" targetRef="Claim_ReturnStage" name="Unsafe or claim rejected" />
    <bpmn:sequenceFlow id="G_ClaimReturnDelivery" sourceRef="Claim_ReturnStage" targetRef="Return_Sender" name="Doorstep claim requires return">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= damageStage = "delivery"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_ClaimReturnHub" sourceRef="Claim_ReturnStage" targetRef="Set_ReturnOutcome" name="Hub claim requires return" />
    <bpmn:sequenceFlow id="G_UninsuredReport" sourceRef="Report_UninsuredDamage" targetRef="Uninsured_Stage" />
    <bpmn:sequenceFlow id="G_UninsuredDoorstep" sourceRef="Uninsured_Stage" targetRef="End_DeliveryDamage" name="Doorstep damage recorded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= damageStage = "delivery"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_UninsuredHub" sourceRef="Uninsured_Stage" targetRef="Uninsured_Fit" name="Hub damage review" />
    <bpmn:sequenceFlow id="G_UninsuredContinue" sourceRef="Uninsured_Fit" targetRef="Prepare_Reship" name="Safe after repack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= safeToContinue = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_UninsuredReturn" sourceRef="Uninsured_Fit" targetRef="Set_ReturnOutcome" name="Unsafe to continue" />
    <bpmn:sequenceFlow id="G_SetReturnTransitComplete" sourceRef="Set_ReturnOutcome" targetRef="Record_MovementComplete" />
    <bpmn:sequenceFlow id="G_ReshipStage" sourceRef="Prepare_Reship" targetRef="Claim_ReshipStage" />
    <bpmn:sequenceFlow id="G_ReshipHub" sourceRef="Claim_ReshipStage" targetRef="Customs_Check" name="Hub damage; resume route">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= damageStage = "hub"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_ReshipDelivery" sourceRef="Claim_ReshipStage" targetRef="Out_ForDelivery" name="Doorstep damage; reship / replace">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= damageStage = "delivery"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_CustomsRequired" sourceRef="Customs_Check" targetRef="Request_CustomsDocs" name="International customs hold">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= customsRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_CustomsDocsWait" sourceRef="Request_CustomsDocs" targetRef="Receive_CustomsDocs" />
    <bpmn:sequenceFlow id="G_CustomsDocsReceived" sourceRef="Receive_CustomsDocs" targetRef="More_Hubs" name="Documents received" />
    <bpmn:sequenceFlow id="G_CustomsExpired" sourceRef="Timer_CustomsDeadline" targetRef="Return_Customs" name="Documents not provided within 5 days" />
    <bpmn:sequenceFlow id="G_CustomsSetReturn" sourceRef="Return_Customs" targetRef="Set_CustomsReturn" />
    <bpmn:sequenceFlow id="G_CustomsToTransitComplete" sourceRef="Set_CustomsReturn" targetRef="Record_MovementComplete" />
    <bpmn:sequenceFlow id="G_CustomsNotRequired" sourceRef="Customs_Check" targetRef="More_Hubs" name="No customs hold" />
    <bpmn:sequenceFlow id="G_DispatchWait" sourceRef="Dispatch_Linehaul" targetRef="Transit_EventChoice" />
    <bpmn:sequenceFlow id="G_WaitDelayMsg" sourceRef="Transit_EventChoice" targetRef="Catch_DelayAlert" />
    <bpmn:sequenceFlow id="G_WaitDelayTimer" sourceRef="Transit_EventChoice" targetRef="Catch_DelayTimer" />
    <bpmn:sequenceFlow id="G_WaitArrival" sourceRef="Transit_EventChoice" targetRef="Catch_Arrival" />
    <bpmn:sequenceFlow id="G_WaitCancel" sourceRef="Transit_EventChoice" targetRef="Catch_CancelShipment" />
    <bpmn:sequenceFlow id="G_CancelCatchStop" sourceRef="Catch_CancelShipment" targetRef="Stop_Movement" name="Cancel after dispatch" />
    <bpmn:sequenceFlow id="G_DelayMsgNotify" sourceRef="Catch_DelayAlert" targetRef="Notify_Delay" />
    <bpmn:sequenceFlow id="G_DelayTimerCheck" sourceRef="Catch_DelayTimer" targetRef="Check_ScanAge" />
    <bpmn:sequenceFlow id="G_ScanAgeDecision" sourceRef="Check_ScanAge" targetRef="Lost_Threshold" />
    <bpmn:sequenceFlow id="G_NotLostDelay" sourceRef="Lost_Threshold" targetRef="Notify_Delay" name="Under 48 hours since last scan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= hoursSinceLastScan &lt; 48</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_LostTrace" sourceRef="Lost_Threshold" targetRef="Trace_Shipment" name="48 hours without a scan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= hoursSinceLastScan &gt;= 48</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_TraceWait" sourceRef="Trace_Shipment" targetRef="Trace_EventChoice" />
    <bpmn:sequenceFlow id="G_TraceFound" sourceRef="Trace_EventChoice" targetRef="Catch_ParcelFound" />
    <bpmn:sequenceFlow id="G_TraceExpire" sourceRef="Trace_EventChoice" targetRef="Catch_TraceExpired" />
    <bpmn:sequenceFlow id="G_TraceFoundScan" sourceRef="Catch_ParcelFound" targetRef="Record_HubScan" />
    <bpmn:sequenceFlow id="G_TraceLostDeclare" sourceRef="Catch_TraceExpired" targetRef="Declare_Lost" />
    <bpmn:sequenceFlow id="G_DeclareLostSet" sourceRef="Declare_Lost" targetRef="Set_LostOutcome" />
    <bpmn:sequenceFlow id="G_LostToComplete" sourceRef="Set_LostOutcome" targetRef="Record_MovementComplete" />
    <bpmn:sequenceFlow id="G_DelayReroute" sourceRef="Notify_Delay" targetRef="Reroute_Alternate" />
    <bpmn:sequenceFlow id="G_RerouteETA" sourceRef="Reroute_Alternate" targetRef="Update_ETA" />
    <bpmn:sequenceFlow id="G_UpdatedETAWait" sourceRef="Update_ETA" targetRef="Transit_EventChoice" />
    <bpmn:sequenceFlow id="G_ArrivalScan" sourceRef="Catch_Arrival" targetRef="Record_HubScan" />
    <bpmn:sequenceFlow id="G_MoreHubLegs" sourceRef="More_Hubs" targetRef="Dispatch_Linehaul" name="Another hub leg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= moreHubLegs = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_DoneHubs" sourceRef="More_Hubs" targetRef="Record_MovementComplete" name="At destination hub" />
    <bpmn:sequenceFlow id="G_CancelStopReturn" sourceRef="Stop_Movement" targetRef="Return_Cancelled" />
    <bpmn:sequenceFlow id="G_CancelReturnComp" sourceRef="Return_Cancelled" targetRef="Compensate_Fee" />
    <bpmn:sequenceFlow id="G_CancelCompSet" sourceRef="Compensate_Fee" targetRef="Set_CancelOutcome" />
    <bpmn:sequenceFlow id="G_CancelOutcomePublish" sourceRef="Set_CancelOutcome" targetRef="Record_MovementComplete" />
    <bpmn:sequenceFlow id="G_TrackingJoin" sourceRef="Tracking_Update" targetRef="Join_Transit" />
    <bpmn:sequenceFlow id="G_TransitJoinMovement" sourceRef="Record_MovementComplete" targetRef="Join_Transit" />
    <bpmn:sequenceFlow id="G_JoinOutcome" sourceRef="Join_Transit" targetRef="Transit_Outcome" />
    <bpmn:sequenceFlow id="G_TransitLost" sourceRef="Transit_Outcome" targetRef="Notify_Lost" name="Lost">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= shipmentOutcome = "lost"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_LostNotifyEnd" sourceRef="Notify_Lost" targetRef="End_Lost" />
    <bpmn:sequenceFlow id="G_TransitReturn" sourceRef="Transit_Outcome" targetRef="Return_Sender" name="Return to sender">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= shipmentOutcome = "return"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_ReturnEnd" sourceRef="Return_Sender" targetRef="End_Returned" />
    <bpmn:sequenceFlow id="G_TransitClaim" sourceRef="Transit_Outcome" targetRef="End_ClaimClosed" name="Claim settled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= shipmentOutcome = "claimClosed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_TransitCancelled" sourceRef="Transit_Outcome" targetRef="End_Cancelled" name="Cancelled after dispatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= shipmentOutcome = "cancelled"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_TransitContinue" sourceRef="Transit_Outcome" targetRef="Out_ForDelivery" name="Continue to delivery" />
    <bpmn:sequenceFlow id="G_OutDeliveryUser" sourceRef="Out_ForDelivery" targetRef="Deliver_Parcel" />
    <bpmn:sequenceFlow id="G_DeliveryChoice" sourceRef="Deliver_Parcel" targetRef="Delivery_Outcome" />
    <bpmn:sequenceFlow id="G_Delivered" sourceRef="Delivery_Outcome" targetRef="Close_Invoice" name="Delivered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "delivered"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_InvoiceEnd" sourceRef="Close_Invoice" targetRef="End_Delivered" />
    <bpmn:sequenceFlow id="G_Unavailable" sourceRef="Delivery_Outcome" targetRef="Count_Delivery" name="Recipient unavailable" />
    <bpmn:sequenceFlow id="G_CountDelivery" sourceRef="Count_Delivery" targetRef="Delivery_Attempts" />
    <bpmn:sequenceFlow id="G_RetryDelivery" sourceRef="Delivery_Attempts" targetRef="Out_ForDelivery" name="Attempts remain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_HoldDepot" sourceRef="Delivery_Attempts" targetRef="Hold_Depot" name="Three attempts exhausted" />
    <bpmn:sequenceFlow id="G_HoldWait" sourceRef="Hold_Depot" targetRef="Depot_EventChoice" />
    <bpmn:sequenceFlow id="G_DepotReroute" sourceRef="Depot_EventChoice" targetRef="Catch_Redelivery" />
    <bpmn:sequenceFlow id="G_DepotExpired" sourceRef="Depot_EventChoice" targetRef="Catch_DepotExpired" />
    <bpmn:sequenceFlow id="G_Redeliver" sourceRef="Catch_Redelivery" targetRef="Out_ForDelivery" />
    <bpmn:sequenceFlow id="G_ExpiredReturn" sourceRef="Catch_DepotExpired" targetRef="Return_Expired" />
    <bpmn:sequenceFlow id="G_ExpiredReturnEnd" sourceRef="Return_Expired" targetRef="End_Returned" />
    <bpmn:sequenceFlow id="G_Refusal" sourceRef="Delivery_Outcome" targetRef="Return_Charges" name="Refusal / cash-on-delivery failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "refused" or deliveryOutcome = "codFailed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_RefusalReturn" sourceRef="Return_Charges" targetRef="Return_Refused" />
    <bpmn:sequenceFlow id="G_RefusalEnd" sourceRef="Return_Refused" targetRef="End_Refused" />
    <bpmn:sequenceFlow id="G_AddressProblem" sourceRef="Delivery_Outcome" targetRef="Contact_Address" name="Address issue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "addressIssue"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_ContactConfirm" sourceRef="Contact_Address" targetRef="Confirm_Address" />
    <bpmn:sequenceFlow id="G_AddressApproval" sourceRef="Confirm_Address" targetRef="Address_Approved" />
    <bpmn:sequenceFlow id="G_AddressApproved" sourceRef="Address_Approved" targetRef="Calculate_Surcharge" name="Recipient approves correction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= addressChangeApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="G_AddressRevisedDelivery" sourceRef="Calculate_Surcharge" targetRef="Out_ForDelivery" />
    <bpmn:sequenceFlow id="G_AddressDenied" sourceRef="Address_Approved" targetRef="Return_Sender" name="Address change refused" />
    <bpmn:sequenceFlow id="G_DeliveryDamage" sourceRef="Delivery_Outcome" targetRef="Check_Insurance" name="Damage found at doorstep">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= deliveryOutcome = "damaged"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:association id="Association_Charge_Refund" sourceRef="Compensation_Charge" targetRef="Refund_ShipmentFee" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ShipmentExceptionManagement">
    <bpmndi:BPMNPlane id="Plane_ShipmentExceptionManagement" bpmnElement="Collaboration_ShipmentExceptionManagement">
      <bpmndi:BPMNShape id="Participant_Main_di" bpmnElement="Participant_Main" isHorizontal="true">
        <dc:Bounds x="80" y="40" width="7100" height="2070" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Shipper_di" bpmnElement="Lane_Shipper" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="7070" height="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="84" width="105" height="222" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Control_di" bpmnElement="Lane_Control" isHorizontal="true">
        <dc:Bounds x="110" y="310" width="7070" height="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="314" width="105" height="222" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pickup_di" bpmnElement="Lane_Pickup" isHorizontal="true">
        <dc:Bounds x="110" y="540" width="7070" height="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="544" width="105" height="222" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Hub_di" bpmnElement="Lane_Hub" isHorizontal="true">
        <dc:Bounds x="110" y="770" width="7070" height="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="774" width="105" height="222" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Delivery_di" bpmnElement="Lane_Delivery" isHorizontal="true">
        <dc:Bounds x="110" y="1000" width="7070" height="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="1004" width="105" height="222" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Recipient_di" bpmnElement="Lane_Recipient" isHorizontal="true">
        <dc:Bounds x="110" y="1230" width="7070" height="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="1234" width="105" height="222" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Claims_di" bpmnElement="Lane_Claims" isHorizontal="true">
        <dc:Bounds x="110" y="1460" width="7070" height="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="1464" width="105" height="222" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="110" y="1690" width="7070" height="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="1694" width="105" height="412" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Book_di" bpmnElement="Start_Book">
        <dc:Bounds x="180" y="177" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Book_Shipment_di" bpmnElement="Book_Shipment">
        <dc:Bounds x="260" y="155" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_Booking_di" bpmnElement="Validate_Booking">
        <dc:Bounds x="420" y="1800" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Booking_Valid_di" bpmnElement="Booking_Valid" isMarkerVisible="true">
        <dc:Bounds x="590" y="1805" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Correct_Booking_di" bpmnElement="Correct_Booking">
        <dc:Bounds x="640" y="135" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Count_BookingFix_di" bpmnElement="Count_BookingFix">
        <dc:Bounds x="990" y="1900" width="110" height="80" />
      </bpmndi:BPMNShape>
