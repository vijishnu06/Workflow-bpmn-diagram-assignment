<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_StudentProjectApproval" targetNamespace="https://example.org/camunda8/bpmn" exporter="Camunda Modeler" exporterVersion="5.XX">
  <bpmn:collaboration id="Collaboration_StudentProjectApproval">
    <bpmn:participant id="Participant_Main" name="Student Project Approval &amp; Allocation System" processRef="Process_StudentProjectApproval" />
  </bpmn:collaboration>
  <bpmn:message id="Message_GuideAccepted" name="guide-allocation-accepted">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= proposalId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_GuideDeclined" name="guide-allocation-declined">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= proposalId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ProjectWithdrawn" name="project-allocation-withdrawn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= proposalId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_NotifyFailed" name="Notification or allocation record failed" errorCode="NOTIFY_OR_RECORD_FAILED" />
  <bpmn:process id="Process_StudentProjectApproval" name="Student Project Approval &amp; Allocation System" isExecutable="true">
    <bpmn:laneSet id="LaneSet_StudentProjectApproval">
      <bpmn:lane id="Lane_Student" name="Student / Team">
        <bpmn:flowNodeRef>Start_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit_Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_SubmissionDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resubmit_Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revise_Topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revise_Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_RevisionSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit_NewTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="Project Coordinator">
        <bpmn:flowNodeRef>Late_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Late_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Escalate_InvalidForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InvalidForm_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review_Similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Similarity_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Manual_GuidePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Manual_Plan_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Manual_AfterDeclines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Manual_Guide_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Manual_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>Committee_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_ReviewSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Escalate_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Committee_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revision_Limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Final_Committee_Vote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Final_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>Catch_GuideAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_GuideDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_GuideTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Withdrawal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>Validate_Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validation_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_ValidationErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ValidationClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check_Similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Similarity_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_ReviewReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wait_SecondSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReviewEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_RevisionLapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RevisionLapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Increment_Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mark_NewTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Match_Guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Guide_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Guide_Waitlist_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allocate_Guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Compensation_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Release_GuideSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_GuideRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Await_GuideResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclude_DeclinedGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Guide_AttemptLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Allocated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Compensate_Withdrawal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Withdrawal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Submit" name="Proposal submission started">
      <bpmn:outgoing>F_StartSubmit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Submit_Proposal" name="Submit project proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_StartSubmit</bpmn:incoming>
      <bpmn:outgoing>F_SubmitValidate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_SubmissionDeadline" name="Proposal deadline" attachedToRef="Submit_Proposal" cancelActivity="true">
      <bpmn:outgoing>F_TimerLate</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Late_Request" name="Request late submission">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_TimerLate</bpmn:incoming>
      <bpmn:outgoing>F_LateDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Late_Decision" name="Late submission approved?" default="F_LateRejected">
      <bpmn:incoming>F_LateDecision</bpmn:incoming>
      <bpmn:outgoing>F_LateApproved</bpmn:outgoing>
      <bpmn:outgoing>F_LateRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Validate_Proposal" name="Validate form and team rules">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-proposal" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SubmitValidate</bpmn:incoming>
      <bpmn:outgoing>F_ValidateGateway</bpmn:outgoing>
      <bpmn:incoming>F_ResubmitValidate</bpmn:incoming>
      <bpmn:incoming>F_MarkNewTopicToValidate</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Validation_Decision" name="Submission valid?" default="F_Valid">
      <bpmn:incoming>F_ValidateGateway</bpmn:incoming>
      <bpmn:outgoing>F_InvalidForm</bpmn:outgoing>
      <bpmn:outgoing>F_TooManyFormErrors</bpmn:outgoing>
      <bpmn:outgoing>F_InvalidTeam</bpmn:outgoing>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_ValidationErrors" name="Send errors and resubmission checklist">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-proposal-feedback" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_InvalidForm</bpmn:incoming>
      <bpmn:outgoing>F_ValidationFeedback</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Resubmit_Proposal" name="Correct and resubmit proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ValidationFeedback</bpmn:incoming>
      <bpmn:outgoing>F_ResubmitValidate</bpmn:outgoing>
      <bpmn:incoming>F_LateApproved</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Escalate_InvalidForm" name="Resolve repeated form errors">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_TooManyFormErrors</bpmn:incoming>
      <bpmn:outgoing>F_CoordFormGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="InvalidForm_Decision" name="Can coordinator resolve?" default="F_FormClosed">
      <bpmn:incoming>F_CoordFormGateway</bpmn:incoming>
      <bpmn:outgoing>F_FormResolved</bpmn:outgoing>
      <bpmn:outgoing>F_FormClosed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ValidationClosed" name="Closed: validation unresolved">
      <bpmn:incoming>F_FormClosed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_InvalidTeam" name="Closed: invalid team">
      <bpmn:incoming>F_NotifyInvalidTeam</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Notify_InvalidTeam" name="Explain team-rule rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-proposal-feedback" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_InvalidTeam</bpmn:incoming>
      <bpmn:outgoing>F_NotifyInvalidTeam</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Screen_Proposal" name="Screen proposal and domain fit">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:incoming>F_FormResolved</bpmn:incoming>
      <bpmn:outgoing>F_ScreenSimilarity</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check_Similarity" name="Check topic similarity and duplicates">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-topic-similarity" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ScreenSimilarity</bpmn:incoming>
      <bpmn:outgoing>F_SimilarityGateway</bpmn:outgoing>
      <bpmn:incoming>F_ModifiedTopicCheck</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Similarity_Decision" name="Similarity within threshold?" default="F_Similar">
      <bpmn:incoming>F_SimilarityGateway</bpmn:incoming>
      <bpmn:outgoing>F_SimilarityLow</bpmn:outgoing>
      <bpmn:outgoing>F_Similar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Review_Similarity" name="Review high-similarity report">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Similar</bpmn:incoming>
      <bpmn:outgoing>F_ReviewSimilarityOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Similarity_Outcome" name="Similarity review outcome?" default="F_SimDuplicate">
      <bpmn:incoming>F_ReviewSimilarityOutcome</bpmn:incoming>
      <bpmn:outgoing>F_SimClear</bpmn:outgoing>
      <bpmn:outgoing>F_SimModify</bpmn:outgoing>
      <bpmn:outgoing>F_SimDuplicate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Revise_Topic" name="Submit modified topic">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SimModify</bpmn:incoming>
      <bpmn:outgoing>F_ModifiedTopicCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Duplicate" name="Closed: duplicate topic">
      <bpmn:incoming>F_SimDuplicate</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Committee_Review" name="Evaluate proposal">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SimilarityLow</bpmn:incoming>
      <bpmn:incoming>F_SimClear</bpmn:incoming>
      <bpmn:outgoing>F_CommitteeToDecision</bpmn:outgoing>
      <bpmn:incoming>F_CountToCommittee</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_ReviewSLA" name="Review SLA reminder" attachedToRef="Committee_Review" cancelActivity="false">
      <bpmn:outgoing>F_ReviewSLA</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Send_ReviewReminder" name="Remind committee and HoD">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-review-reminder" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ReviewSLA</bpmn:incoming>
      <bpmn:outgoing>F_SendReviewReminder</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Wait_SecondSLA" name="Second SLA interval">
      <bpmn:incoming>F_SendReviewReminder</bpmn:incoming>
      <bpmn:outgoing>F_SecondReviewSLA</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Escalate_Review" name="Escalate overdue review to HoD">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SecondReviewSLA</bpmn:incoming>
      <bpmn:outgoing>F_EscalateReviewEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ReviewEscalated" name="Review escalation recorded">
      <bpmn:incoming>F_EscalateReviewEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Committee_Decision" name="Committee decision?" default="F_CommitteeReject">
      <bpmn:incoming>F_CommitteeToDecision</bpmn:incoming>
      <bpmn:outgoing>F_CommitteeApprove</bpmn:outgoing>
      <bpmn:outgoing>F_CommitteeRevise</bpmn:outgoing>
      <bpmn:outgoing>F_CommitteeReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Revision_Limit" name="F5: revision cycles remaining?" default="F_RevisionFinal">
      <bpmn:incoming>F_CommitteeRevise</bpmn:incoming>
      <bpmn:outgoing>F_RevisionAllowed</bpmn:outgoing>
      <bpmn:outgoing>F_RevisionFinal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Revise_Proposal" name="Revise proposal (7-day SLA)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_RevisionAllowed</bpmn:incoming>
      <bpmn:outgoing>F_RevisionToCount</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_RevisionSLA" name="Revision overdue" attachedToRef="Revise_Proposal" cancelActivity="true">
      <bpmn:outgoing>F_RevisionTimer</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Notify_RevisionLapsed" name="Notify revision overdue and close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-proposal-lapsed" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_RevisionTimer</bpmn:incoming>
      <bpmn:outgoing>F_RevisionOverdue</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RevisionLapsed" name="Closed: revision lapsed">
      <bpmn:incoming>F_RevisionOverdue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Increment_Revision" name="Increment revision cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="increment-revision-cycle" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_RevisionToCount</bpmn:incoming>
      <bpmn:outgoing>F_CountToCommittee</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Final_Committee_Vote" name="Final committee approve / reject">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_RevisionFinal</bpmn:incoming>
      <bpmn:outgoing>F_FinalVoteDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Final_Decision" name="Final decision?" default="F_FinalReject">
      <bpmn:incoming>F_FinalVoteDecision</bpmn:incoming>
      <bpmn:outgoing>F_FinalApproved</bpmn:outgoing>
      <bpmn:outgoing>F_FinalReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Rejected_Decision" name="New topic submission still available?" default="F_RejectedFinal">
      <bpmn:incoming>F_CommitteeReject</bpmn:incoming>
      <bpmn:incoming>F_FinalReject</bpmn:incoming>
      <bpmn:outgoing>F_OneNewTopic</bpmn:outgoing>
      <bpmn:outgoing>F_RejectedFinal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_Rejection" name="Send rejection reasons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-proposal-feedback" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_OneNewTopic</bpmn:incoming>
      <bpmn:outgoing>F_SendRejectionToTopic</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Submit_NewTopic" name="Submit one new topic">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SendRejectionToTopic</bpmn:incoming>
      <bpmn:outgoing>F_NewTopicToMark</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Mark_NewTopic" name="Record new-topic allowance used">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-new-topic" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_NewTopicToMark</bpmn:incoming>
      <bpmn:outgoing>F_MarkNewTopicToValidate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Closed: proposal rejected">
      <bpmn:incoming>F_RejectedFinal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Match_Guide" name="Match guide by domain and workload">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="match-faculty-guide" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_CommitteeApprove</bpmn:incoming>
      <bpmn:incoming>F_FinalApproved</bpmn:incoming>
      <bpmn:outgoing>F_GuideMatchToAvailable</bpmn:outgoing>
      <bpmn:incoming>F_WaitlistRematch</bpmn:incoming>
      <bpmn:incoming>F_Rematch</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Guide_Available" name="Matching guide available?" default="F_NoGuide">
      <bpmn:incoming>F_GuideMatchToAvailable</bpmn:incoming>
      <bpmn:outgoing>F_GuideFound</bpmn:outgoing>
      <bpmn:outgoing>F_NoGuide</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Manual_GuidePlan" name="Choose manual guide, co-guide or waitlist">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_NoGuide</bpmn:incoming>
      <bpmn:outgoing>F_ManualGuidePlan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Manual_Plan_Decision" name="Guide allocation plan?" default="F_PlanManualAllocate">
      <bpmn:incoming>F_ManualGuidePlan</bpmn:incoming>
      <bpmn:outgoing>F_PlanWaitlist</bpmn:outgoing>
      <bpmn:outgoing>F_PlanManualAllocate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Guide_Waitlist_Timer" name="Waitlist review interval">
      <bpmn:incoming>F_PlanWaitlist</bpmn:incoming>
      <bpmn:outgoing>F_WaitlistRematch</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Allocate_Guide" name="Allocate guide in project system">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="allocate-faculty-guide" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_GuideFound</bpmn:incoming>
      <bpmn:incoming>F_PlanManualAllocate</bpmn:incoming>
      <bpmn:outgoing>F_AllocatedToSendRequest</bpmn:outgoing>
      <bpmn:incoming>F_ManualGuideAvailable</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Compensation_Allocate" name="Guide-slot compensation handler" attachedToRef="Allocate_Guide" cancelActivity="false">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Release_GuideSlot" name="Release reserved guide slot" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-faculty-guide-slot" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_GuideRequest" name="Send allocation request to guide">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-guide-allocation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_AllocatedToSendRequest</bpmn:incoming>
      <bpmn:outgoing>F_GuideRequestToWait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Await_GuideResponse" name="Guide accepts, declines, times out or withdraws?">
      <bpmn:incoming>F_GuideRequestToWait</bpmn:incoming>
      <bpmn:outgoing>F_WaitAccepted</bpmn:outgoing>
      <bpmn:outgoing>F_WaitDeclined</bpmn:outgoing>
      <bpmn:outgoing>F_WaitTimeout</bpmn:outgoing>
      <bpmn:outgoing>F_WaitWithdraw</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_GuideAccepted" name="F9: Guide accepts">
      <bpmn:incoming>F_WaitAccepted</bpmn:incoming>
      <bpmn:outgoing>F_GuideAcceptedNotify</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_GuideAccepted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_GuideDeclined" name="F9: Guide declines">
      <bpmn:incoming>F_WaitDeclined</bpmn:incoming>
      <bpmn:outgoing>F_GuideDeclinedCount</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_GuideDeclined" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_GuideTimeout" name="F9: No guide response in 3 days">
      <bpmn:incoming>F_WaitTimeout</bpmn:incoming>
      <bpmn:outgoing>F_GuideTimeoutCount</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Withdrawal" name="F11: Team withdraws after approval">
      <bpmn:incoming>F_WaitWithdraw</bpmn:incoming>
      <bpmn:outgoing>F_WithdrawalCompensate</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ProjectWithdrawn" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Exclude_DeclinedGuide" name="Exclude guide and increment attempt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="exclude-guide-and-count" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_GuideDeclinedCount</bpmn:incoming>
      <bpmn:incoming>F_GuideTimeoutCount</bpmn:incoming>
      <bpmn:outgoing>F_ExcludeToLimit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Guide_AttemptLimit" name="F9: fewer than 3 guide attempts?" default="F_ManualGuide">
      <bpmn:incoming>F_ExcludeToLimit</bpmn:incoming>
      <bpmn:outgoing>F_Rematch</bpmn:outgoing>
      <bpmn:outgoing>F_ManualGuide</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Manual_AfterDeclines" name="Coordinator resolves guide refusal">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ManualGuide</bpmn:incoming>
      <bpmn:outgoing>F_ManualResolveDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Manual_Guide_Decision" name="Manual guide available?" default="F_NoGuideEnd">
      <bpmn:incoming>F_ManualResolveDecision</bpmn:incoming>
      <bpmn:outgoing>F_ManualGuideAvailable</bpmn:outgoing>
      <bpmn:outgoing>F_NoGuideEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NoGuide" name="Closed: no guide available">
      <bpmn:incoming>F_NoGuideEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Notify_Student" name="Notify student and record allocation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-student-record-guide" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_GuideAcceptedNotify</bpmn:incoming>
      <bpmn:outgoing>F_NotifySuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Notify_Error" name="F10: Notification / database error" attachedToRef="Notify_Student" cancelActivity="true">
      <bpmn:outgoing>F_NotifyError</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_NotifyFailed" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Manual_Notify" name="F10: Notify student and record manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_NotifyError</bpmn:incoming>
      <bpmn:outgoing>F_ManualNotifySuccess</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Allocated" name="Project and guide allocation confirmed">
      <bpmn:incoming>F_NotifySuccess</bpmn:incoming>
      <bpmn:incoming>F_ManualNotifySuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Compensate_Withdrawal" name="Compensate reserved guide slot">
      <bpmn:incoming>F_WithdrawalCompensate</bpmn:incoming>
      <bpmn:outgoing>F_WithdrawalNotify</bpmn:outgoing>
      <bpmn:compensateEventDefinition activityRef="Allocate_Guide" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="Notify_Withdrawal" name="Record withdrawal and notify parties">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-allocation-withdrawal" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_WithdrawalNotify</bpmn:incoming>
      <bpmn:outgoing>F_WithdrawalEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Withdrawn" name="Closed: team withdrawn">
      <bpmn:incoming>F_WithdrawalEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Lapsed" name="Closed: submission deadline">
      <bpmn:incoming>F_LateRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_StartSubmit" sourceRef="Start_Submit" targetRef="Submit_Proposal" />
    <bpmn:sequenceFlow id="F_SubmitValidate" sourceRef="Submit_Proposal" targetRef="Validate_Proposal" />
    <bpmn:sequenceFlow id="F_ValidateGateway" sourceRef="Validate_Proposal" targetRef="Validation_Decision" />
    <bpmn:sequenceFlow id="F_InvalidForm" sourceRef="Validation_Decision" targetRef="Send_ValidationErrors" name="F1: incomplete or invalid form">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formValid = false and teamRulesValid = true and proposalAttempts &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_TooManyFormErrors" sourceRef="Validation_Decision" targetRef="Escalate_InvalidForm" name="F1: coordinator escalation after 2 attempts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formValid = false and teamRulesValid = true and proposalAttempts &gt;= 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_InvalidTeam" sourceRef="Validation_Decision" targetRef="Notify_InvalidTeam" name="F2: invalid team rules">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= teamRulesValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Valid" sourceRef="Validation_Decision" targetRef="Screen_Proposal" name="Valid submission" />
    <bpmn:sequenceFlow id="F_ValidationFeedback" sourceRef="Send_ValidationErrors" targetRef="Resubmit_Proposal" />
    <bpmn:sequenceFlow id="F_ResubmitValidate" sourceRef="Resubmit_Proposal" targetRef="Validate_Proposal" />
    <bpmn:sequenceFlow id="F_CoordFormGateway" sourceRef="Escalate_InvalidForm" targetRef="InvalidForm_Decision" />
    <bpmn:sequenceFlow id="F_FormResolved" sourceRef="InvalidForm_Decision" targetRef="Screen_Proposal" name="Coordinator resolved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formExceptionResolved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_FormClosed" sourceRef="InvalidForm_Decision" targetRef="End_ValidationClosed" name="Closed after validation escalation" />
    <bpmn:sequenceFlow id="F_NotifyInvalidTeam" sourceRef="Notify_InvalidTeam" targetRef="End_InvalidTeam" />
    <bpmn:sequenceFlow id="F_TimerLate" sourceRef="Timer_SubmissionDeadline" targetRef="Late_Request" name="Late request" />
    <bpmn:sequenceFlow id="F_LateDecision" sourceRef="Late_Request" targetRef="Late_Decision" />
    <bpmn:sequenceFlow id="F_LateApproved" sourceRef="Late_Decision" targetRef="Resubmit_Proposal" name="Late submission approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= lateSubmissionApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_LateRejected" sourceRef="Late_Decision" targetRef="End_Lapsed" name="Late request rejected" />
    <bpmn:sequenceFlow id="F_ScreenSimilarity" sourceRef="Screen_Proposal" targetRef="Check_Similarity" />
    <bpmn:sequenceFlow id="F_SimilarityGateway" sourceRef="Check_Similarity" targetRef="Similarity_Decision" />
    <bpmn:sequenceFlow id="F_SimilarityLow" sourceRef="Similarity_Decision" targetRef="Committee_Review" name="Below similarity threshold">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= similarityScore &lt; similarityThreshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Similar" sourceRef="Similarity_Decision" targetRef="Review_Similarity" name="Above threshold" />
    <bpmn:sequenceFlow id="F_ReviewSimilarityOutcome" sourceRef="Review_Similarity" targetRef="Similarity_Outcome" />
    <bpmn:sequenceFlow id="F_SimClear" sourceRef="Similarity_Outcome" targetRef="Committee_Review" name="Reviewed as acceptable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= similarityDisposition = "clear"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_SimModify" sourceRef="Similarity_Outcome" targetRef="Revise_Topic" name="Request topic modification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= similarityDisposition = "modify"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_SimDuplicate" sourceRef="Similarity_Outcome" targetRef="End_Duplicate" name="Confirmed duplicate / reject" />
    <bpmn:sequenceFlow id="F_ModifiedTopicCheck" sourceRef="Revise_Topic" targetRef="Check_Similarity" />
    <bpmn:sequenceFlow id="F_CommitteeToDecision" sourceRef="Committee_Review" targetRef="Committee_Decision" />
    <bpmn:sequenceFlow id="F_ReviewSLA" sourceRef="Timer_ReviewSLA" targetRef="Send_ReviewReminder" />
    <bpmn:sequenceFlow id="F_SendReviewReminder" sourceRef="Send_ReviewReminder" targetRef="Wait_SecondSLA" />
    <bpmn:sequenceFlow id="F_SecondReviewSLA" sourceRef="Wait_SecondSLA" targetRef="Escalate_Review" />
    <bpmn:sequenceFlow id="F_EscalateReviewEnd" sourceRef="Escalate_Review" targetRef="End_ReviewEscalated" />
    <bpmn:sequenceFlow id="F_CommitteeApprove" sourceRef="Committee_Decision" targetRef="Match_Guide" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CommitteeRevise" sourceRef="Committee_Decision" targetRef="Revision_Limit" name="Request revision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "revise"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CommitteeReject" sourceRef="Committee_Decision" targetRef="Rejected_Decision" name="Rejected" />
    <bpmn:sequenceFlow id="F_RevisionAllowed" sourceRef="Revision_Limit" targetRef="Revise_Proposal" name="Revision cycles remain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= revisionCycles &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_RevisionFinal" sourceRef="Revision_Limit" targetRef="Final_Committee_Vote" name="Maximum reached; final approve/reject" />
    <bpmn:sequenceFlow id="F_RevisionTimer" sourceRef="Timer_RevisionSLA" targetRef="Notify_RevisionLapsed" />
    <bpmn:sequenceFlow id="F_RevisionOverdue" sourceRef="Notify_RevisionLapsed" targetRef="End_RevisionLapsed" />
    <bpmn:sequenceFlow id="F_RevisionToCount" sourceRef="Revise_Proposal" targetRef="Increment_Revision" />
    <bpmn:sequenceFlow id="F_CountToCommittee" sourceRef="Increment_Revision" targetRef="Committee_Review" />
    <bpmn:sequenceFlow id="F_FinalVoteDecision" sourceRef="Final_Committee_Vote" targetRef="Final_Decision" />
    <bpmn:sequenceFlow id="F_FinalApproved" sourceRef="Final_Decision" targetRef="Match_Guide" name="Final approval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= finalCommitteeDecision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_FinalReject" sourceRef="Final_Decision" targetRef="Rejected_Decision" name="Final rejection" />
    <bpmn:sequenceFlow id="F_OneNewTopic" sourceRef="Rejected_Decision" targetRef="Send_Rejection" name="First rejection; new topic still allowed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= newTopicUsed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_RejectedFinal" sourceRef="Rejected_Decision" targetRef="End_Rejected" name="New-topic allowance already used" />
    <bpmn:sequenceFlow id="F_SendRejectionToTopic" sourceRef="Send_Rejection" targetRef="Submit_NewTopic" />
    <bpmn:sequenceFlow id="F_NewTopicToMark" sourceRef="Submit_NewTopic" targetRef="Mark_NewTopic" />
    <bpmn:sequenceFlow id="F_MarkNewTopicToValidate" sourceRef="Mark_NewTopic" targetRef="Validate_Proposal" />
    <bpmn:sequenceFlow id="F_GuideMatchToAvailable" sourceRef="Match_Guide" targetRef="Guide_Available" />
    <bpmn:sequenceFlow id="F_GuideFound" sourceRef="Guide_Available" targetRef="Allocate_Guide" name="Matching guide found">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= guideAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NoGuide" sourceRef="Guide_Available" targetRef="Manual_GuidePlan" name="No matching guide" />
    <bpmn:sequenceFlow id="F_ManualGuidePlan" sourceRef="Manual_GuidePlan" targetRef="Manual_Plan_Decision" />
    <bpmn:sequenceFlow id="F_PlanWaitlist" sourceRef="Manual_Plan_Decision" targetRef="Guide_Waitlist_Timer" name="Waitlist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= guideAllocationPlan = "waitlist"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_PlanManualAllocate" sourceRef="Manual_Plan_Decision" targetRef="Allocate_Guide" name="Manual/co-guide allocation" />
    <bpmn:sequenceFlow id="F_WaitlistRematch" sourceRef="Guide_Waitlist_Timer" targetRef="Match_Guide" name="Review waitlist / rerun match" />
    <bpmn:sequenceFlow id="F_AllocatedToSendRequest" sourceRef="Allocate_Guide" targetRef="Send_GuideRequest" />
    <bpmn:sequenceFlow id="F_GuideRequestToWait" sourceRef="Send_GuideRequest" targetRef="Await_GuideResponse" />
    <bpmn:sequenceFlow id="F_WaitAccepted" sourceRef="Await_GuideResponse" targetRef="Catch_GuideAccepted" />
    <bpmn:sequenceFlow id="F_WaitDeclined" sourceRef="Await_GuideResponse" targetRef="Catch_GuideDeclined" />
    <bpmn:sequenceFlow id="F_WaitTimeout" sourceRef="Await_GuideResponse" targetRef="Catch_GuideTimeout" />
    <bpmn:sequenceFlow id="F_WaitWithdraw" sourceRef="Await_GuideResponse" targetRef="Catch_Withdrawal" />
    <bpmn:sequenceFlow id="F_GuideDeclinedCount" sourceRef="Catch_GuideDeclined" targetRef="Exclude_DeclinedGuide" name="Declined" />
    <bpmn:sequenceFlow id="F_GuideTimeoutCount" sourceRef="Catch_GuideTimeout" targetRef="Exclude_DeclinedGuide" name="No response" />
    <bpmn:sequenceFlow id="F_ExcludeToLimit" sourceRef="Exclude_DeclinedGuide" targetRef="Guide_AttemptLimit" />
    <bpmn:sequenceFlow id="F_Rematch" sourceRef="Guide_AttemptLimit" targetRef="Match_Guide" name="Attempts remain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= guideAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ManualGuide" sourceRef="Guide_AttemptLimit" targetRef="Manual_AfterDeclines" name="After 3 attempts" />
    <bpmn:sequenceFlow id="F_ManualResolveDecision" sourceRef="Manual_AfterDeclines" targetRef="Manual_Guide_Decision" />
    <bpmn:sequenceFlow id="F_ManualGuideAvailable" sourceRef="Manual_Guide_Decision" targetRef="Allocate_Guide" name="Coordinator finds another guide">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualGuideAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NoGuideEnd" sourceRef="Manual_Guide_Decision" targetRef="End_NoGuide" name="No feasible guide / close" />
    <bpmn:sequenceFlow id="F_GuideAcceptedNotify" sourceRef="Catch_GuideAccepted" targetRef="Notify_Student" name="Guide accepts" />
    <bpmn:sequenceFlow id="F_NotifySuccess" sourceRef="Notify_Student" targetRef="End_Allocated" />
    <bpmn:sequenceFlow id="F_NotifyError" sourceRef="Notify_Error" targetRef="Manual_Notify" name="Fallback after retries" />
    <bpmn:sequenceFlow id="F_ManualNotifySuccess" sourceRef="Manual_Notify" targetRef="End_Allocated" />
    <bpmn:sequenceFlow id="F_WithdrawalCompensate" sourceRef="Catch_Withdrawal" targetRef="Compensate_Withdrawal" name="Team withdraws after approval" />
    <bpmn:sequenceFlow id="F_WithdrawalNotify" sourceRef="Compensate_Withdrawal" targetRef="Notify_Withdrawal" />
    <bpmn:sequenceFlow id="F_WithdrawalEnd" sourceRef="Notify_Withdrawal" targetRef="End_Withdrawn" />
    <bpmn:association id="Association_Allocate_Release" sourceRef="Compensation_Allocate" targetRef="Release_GuideSlot" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_StudentProjectApproval">
    <bpmndi:BPMNPlane id="Plane_StudentProjectApproval" bpmnElement="Collaboration_StudentProjectApproval">
      <bpmndi:BPMNShape id="Participant_Main_di" bpmnElement="Participant_Main" isHorizontal="true">
        <dc:Bounds x="80" y="40" width="5000" height="1220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Student_di" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="4970" height="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="84" width="105" height="212" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinator_di" bpmnElement="Lane_Coordinator" isHorizontal="true">
        <dc:Bounds x="110" y="300" width="4970" height="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="304" width="105" height="212" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Committee_di" bpmnElement="Lane_Committee" isHorizontal="true">
        <dc:Bounds x="110" y="520" width="4970" height="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="524" width="105" height="212" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Guide_di" bpmnElement="Lane_Guide" isHorizontal="true">
        <dc:Bounds x="110" y="740" width="4970" height="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="744" width="105" height="212" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="110" y="960" width="4970" height="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="112" y="964" width="105" height="292" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Submit_di" bpmnElement="Start_Submit">
        <dc:Bounds x="185" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Submit_Proposal_di" bpmnElement="Submit_Proposal">
        <dc:Bounds x="270" y="150" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_SubmissionDeadline_di" bpmnElement="Timer_SubmissionDeadline">
        <dc:Bounds x="345" y="205" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Late_Request_di" bpmnElement="Late_Request">
        <dc:Bounds x="410" y="365" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Late_Decision_di" bpmnElement="Late_Decision" isMarkerVisible="true">
        <dc:Bounds x="555" y="380" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_Proposal_di" bpmnElement="Validate_Proposal">
        <dc:Bounds x="430" y="1030" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validation_Decision_di" bpmnElement="Validation_Decision" isMarkerVisible="true">
        <dc:Bounds x="585" y="1045" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_ValidationErrors_di" bpmnElement="Send_ValidationErrors">
        <dc:Bounds x="730" y="1070" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Resubmit_Proposal_di" bpmnElement="Resubmit_Proposal">
        <dc:Bounds x="730" y="125" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escalate_InvalidForm_di" bpmnElement="Escalate_InvalidForm">
        <dc:Bounds x="900" y="365" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InvalidForm_Decision_di" bpmnElement="InvalidForm_Decision" isMarkerVisible="true">
        <dc:Bounds x="1060" y="380" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ValidationClosed_di" bpmnElement="End_ValidationClosed">
        <dc:Bounds x="1150" y="1088" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_InvalidTeam_di" bpmnElement="End_InvalidTeam">
